@model GestorContas.Web.Models.Conta

@{
    ViewData["Title"] = "Editar Conta";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0">
                <div class="card-header bg-primary text-white">
                    <h3 class="mb-0">
                        <i class="bi bi-pencil-square"></i> Editar Conta
                    </h3>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <input type="hidden" asp-for="Id" />
                        
                        <div class="row g-3">
                            <!-- Nome -->
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="Nome" 
                                           class="form-control" 
                                           id="nome" 
                                           placeholder="Nome da conta"
                                           autofocus />
                                    <label asp-for="Nome">
                                        <i class="bi bi-wallet-fill"></i> Nome
                                    </label>
                                    <span asp-validation-for="Nome" class="text-danger small"></span>
                                </div>
                            </div>

                            <!-- Saldo Inicial -->
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <input asp-for="SaldoInicial" 
                                           class="form-control" 
                                           id="saldoInicial" 
                                           placeholder="0,00"
                                           type="number"
                                           step="0.01" />
                                    <label asp-for="SaldoInicial">
                                        <i class="bi bi-currency-dollar"></i> Saldo Inicial
                                    </label>
                                    <span asp-validation-for="SaldoInicial" class="text-danger small"></span>
                                </div>
                            </div>

                            <!-- Descrição -->
                            <div class="col-12">
                                <div class="form-floating">
                                    <textarea asp-for="Descricao" 
                                              class="form-control" 
                                              id="descricao" 
                                              placeholder="Descrição da conta"
                                              style="height: 100px"></textarea>
                                    <label asp-for="Descricao">
                                        <i class="bi bi-card-text"></i> Descrição
                                    </label>
                                    <span asp-validation-for="Descricao" class="text-danger small"></span>
                                </div>
                            </div>

                            <!-- Ativa -->
                            <div class="col-12">
                                <div class="form-check form-switch">
                                    <input asp-for="Ativa" 
                                           class="form-check-input" 
                                           type="checkbox" 
                                           id="ativa" />
                                    <label class="form-check-label" for="ativa">
                                        <i class="bi bi-check-circle"></i> Conta Ativa
                                    </label>
                                </div>
                            </div>
                        </div>

                        <hr class="my-4">

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-primary btn-lg">
                                <i class="bi bi-check-circle"></i> Salvar Alterações
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
}
