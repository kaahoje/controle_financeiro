@using GestorContas.Web.Models.Enums
@{
    // Verifica se é uma requisição AJAX para não renderizar o Layout
    var isAjax = Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest";
    if (isAjax) {
        Layout = null;
    }
    ViewData["Title"] = "Importar Extrato CSV";
}

<div class="@(isAjax ? "" : "container mt-4")">
    <div class="row">
        <div class="col-md-12">
            <div class="@(isAjax ? "" : "card shadow-sm border-0 rounded-3")">
                @if (!isAjax)
                {
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center p-3">
                        <h4 class="mb-0"><i class="bi bi-file-earmark-spreadsheet me-2"></i>Importar Extrato CSV</h4>
                        <a asp-action="Index" class="btn btn-light btn-sm"><i class="bi bi-arrow-left me-1"></i>Voltar</a>
                    </div>
                }
                <div class="@(isAjax ? "" : "card-body p-4")">
                    <div class="row mb-4">
                        <div class="col-md-12">
                            <div id="drop-zone" class="border border-2 border-dashed rounded-3 p-5 text-center bg-light cursor-pointer" style="transition: all 0.3s ease;">
                                <i class="bi bi-file-earmark-arrow-up display-1 text-primary mb-3"></i>
                                <h5>Arraste o arquivo CSV ou OFX aqui</h5>
                                <p class="text-muted">Ou clique para selecionar um arquivo</p>
                                <input type="file" id="fileInput" accept=".csv,.ofx" class="d-none" />
                                <button type="button" class="btn btn-primary" onclick="document.getElementById('fileInput').click()">Selecionar Arquivo (CSV / OFX)</button>
                            </div>
                        </div>
                    </div>

                    <div class="row mb-4 justify-content-center">
                        <div class="col-md-6">
                            <div class="card bg-light border-0 shadow-sm">
                                <div class="card-body py-2 px-3 d-flex align-items-center justify-content-between">
                                    <span class="small text-secondary fw-bold"><i class="bi bi-gear-fill me-1"></i> Separador CSV:</span>
                                    <div class="btn-group btn-group-sm" role="group" id="csv-separator-group">
                                        <input type="radio" class="btn-check" name="csvSeparator" id="sep-semicolon" value=";" checked>
                                        <label class="btn btn-outline-primary px-3" for="sep-semicolon">Ponto e vírgula ( ; )</label>

                                        <input type="radio" class="btn-check" name="csvSeparator" id="sep-comma" value=",">
                                        <label class="btn btn-outline-primary px-3" for="sep-comma">Vírgula ( , )</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div id="processing-status" class="d-none mb-4">
                        <div class="d-flex align-items-center mb-2">
                            <div class="spinner-border spinner-border-sm text-primary me-2" role="status"></div>
                            <span id="status-text">Processando arquivo...</span>
                        </div>
                        <div class="progress" style="height: 10px;">
                            <div id="progress-bar" class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 100%"></div>
                        </div>
                    </div>

                    <div id="results-container" class="d-none">
                        <hr />
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h5 class="mb-0 text-secondary">Lançamentos Detectados</h5>
                            <div class="d-flex align-items-center">
                                <div class="me-3" style="min-width: 300px;">
                                    <div class="input-group input-group-sm">
                                        <span class="input-group-text bg-light"><i class="bi bi-wallet2 me-1"></i> Conta:</span>
                                        <select id="global-conta" class="form-select border-info shadow-none">
                                            <!-- Populados dinamicamente -->
                                        </select>
                                    </div>
                                </div>
                                <span class="badge bg-info text-dark me-2" id="item-count">0 itens</span>
                                <button type="button" class="btn btn-outline-danger btn-sm" id="btn-clear-all"><i class="bi bi-trash me-1"></i>Limpar Tudo</button>
                            </div>
                        </div>

                        <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                            <table class="table table-hover align-middle border" id="import-table">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th style="width: 45px;" class="text-center"><input type="checkbox" id="chk-select-all" class="form-check-input" checked></th>
                                        <th style="width: 130px;">Data</th>
                                        <th>Descrição</th>
                                        <th style="width: 150px;">Valor</th>
                                        <th style="width: 110px;">Tipo</th>
                                        <th style="width: 200px;">Categoria</th>
                                        <th style="width: 130px;">Status</th>
                                        <th style="width: 70px;" class="text-center">Ações</th>
                                    </tr>
                                </thead>
                                <tbody id="import-tbody">
                                    <!-- Dynamic content -->
                                </tbody>
                            </table>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="button" class="btn btn-success btn-lg shadow-sm" id="btn-save-all">
                                <i class="bi bi-check-circle-fill me-2"></i>Salvar Lançamentos Selecionados
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Template for Categoria and Conta Selects -->
<div class="d-none">
    <select id="tpl-categoria">
        @foreach (var item in (SelectList)ViewBag.Categorias)
        {
            <option value="@item.Value">@item.Text</option>
        }
    </select>
    <select id="tpl-conta">
        @foreach (var item in (SelectList)ViewBag.Contas)
        {
            <option value="@item.Value">@item.Text</option>
        }
    </select>
    <datalist id="lista-descricoes">
        <!-- Populados via JS -->
    </datalist>
</div>

@Html.AntiForgeryToken()

<script>
    (function() {
        const dropZone = document.getElementById('drop-zone');
        const fileInput = document.getElementById('fileInput');
        const processingStatus = document.getElementById('processing-status');
        const resultsContainer = document.getElementById('results-container');
        const importTbody = document.getElementById('import-tbody');
        const tplCategoria = document.getElementById('tpl-categoria');
        const tplConta = document.getElementById('tpl-conta');
        const globalConta = document.getElementById('global-conta');
        const listaDescricoes = document.getElementById('lista-descricoes');

        // Inicializar o select global de conta
        globalConta.innerHTML = tplConta.innerHTML;

        // Buscar descrições históricas para o autocomplete
        async function fetchDescricoes() {
            try {
                const response = await fetch('@Url.Action("GetDescricoes", "Lancamentos")');
                const data = await response.json();
                listaDescricoes.innerHTML = data.map(d => `<option value="${d}">`).join('');
            } catch (error) {
                console.error("Erro ao carregar autocomplete:", error);
            }
        }
        fetchDescricoes();

        dropZone.addEventListener('dragover', (e) => {
            e.preventDefault();
            dropZone.classList.add('bg-primary', 'bg-opacity-10', 'border-primary');
        });

        dropZone.addEventListener('dragleave', () => {
            dropZone.classList.remove('bg-primary', 'bg-opacity-10', 'border-primary');
        });

        dropZone.addEventListener('drop', (e) => {
            e.preventDefault();
            dropZone.classList.remove('bg-primary', 'bg-opacity-10', 'border-primary');
            const file = e.dataTransfer.files[0];
            if (file) handleFile(file);
        });

        fileInput.addEventListener('change', (e) => {
            const file = e.target.files[0];
            if (file) handleFile(file);
        });

        let rawFileText = '';
        let currentFileName = '';

        function handleFile(file) {
            const fileName = file.name.toLowerCase();
            if (!fileName.endsWith('.csv') && !fileName.endsWith('.ofx')) {
                Swal.fire('Erro', 'Por favor, selecione um arquivo CSV ou OFX válido.', 'error');
                return;
            }

            currentFileName = fileName;

            const reader = new FileReader();
            reader.onload = (e) => {
                const text = e.target.result;
                
                // Se o texto conter bytes nulos, provavelmente é UTF-16 lido como ISO-8859-1
                if (text.includes('\0')) {
                    console.log("Detectado bytes nulos no arquivo. Lendo novamente como UTF-16...");
                    const utf16Reader = new FileReader();
                    utf16Reader.onload = (e2) => {
                        rawFileText = e2.target.result;
                        processText(rawFileText, fileName);
                    };
                    utf16Reader.readAsText(file, 'UTF-16');
                } else {
                    rawFileText = text;
                    processText(rawFileText, fileName);
                }
            };
            reader.readAsText(file, 'ISO-8859-1');
        }

        function processText(text, fileName) {
            if (fileName.endsWith('.ofx')) {
                parseOfx(text);
            } else {
                parseCsv(text);
            }
        }

        let parsedLancamentos = [];

        function parseCsv(text) {
            processingStatus.classList.remove('d-none');
            resultsContainer.classList.add('d-none');
            importTbody.innerHTML = '';

            const lines = text.split(/\r?\n/);
            const lancamentos = [];

            // Auto-detectar separador (, ou ;) escaneando as primeiras 10 linhas
            let separator = ';';
            let totalSemicolons = 0;
            let totalCommas = 0;
            const linesToScan = lines.slice(0, 10);
            for (const line of linesToScan) {
                totalSemicolons += (line.match(/;/g) || []).length;
                totalCommas += (line.match(/,/g) || []).length;
            }

            if (totalCommas > 0 || totalSemicolons > 0) {
                if (totalCommas > totalSemicolons) {
                    separator = ',';
                    const radioComma = document.getElementById('sep-comma');
                    if (radioComma) radioComma.checked = true;
                } else {
                    separator = ';';
                    const radioSemicolon = document.getElementById('sep-semicolon');
                    if (radioSemicolon) radioSemicolon.checked = true;
                }
            }

            // Usar o separador atualmente selecionado pelo usuário (que pode ter sido alterado manualmente antes)
            const activeSeparatorRadio = document.querySelector('input[name="csvSeparator"]:checked');
            if (activeSeparatorRadio) {
                separator = activeSeparatorRadio.value;
            }

            for (let i = 1; i < lines.length; i++) {
                const line = lines[i].trim();
                if (!line) continue;

                const columns = line.split(separator);
                if (columns.length < 5) continue;

                const dataStr = columns[0].trim();
                const historico = columns[3].trim();
                const valorStr = columns[4].trim();

                if (historico.toUpperCase().includes('SALDO ANTERIOR')) continue;
                if (!/^\d{2}\/\d{2}\/\d{4}$/.test(dataStr)) continue;

                const valorLimpo = valorStr.replace(/\./g, '').replace(',', '.');
                const valor = parseFloat(valorLimpo);

                if (isNaN(valor)) continue;

                const partesData = dataStr.split('/');
                const dataIso = `${partesData[2]}-${partesData[1]}-${partesData[0]}`;

                lancamentos.push({
                    data: dataIso,
                    descricao: historico,
                    valor: Math.abs(valor),
                    tipo: valor < 0 ? 2 : 1
                });
            }

            parsedLancamentos = lancamentos;
            verificarDuplicadosEDisplay();
        }

        function parseOfx(text) {
            try {
                processingStatus.classList.remove('d-none');
                resultsContainer.classList.add('d-none');
                importTbody.innerHTML = '';

                console.log("OFX RAW LENGTH:", text.length);
                console.log("OFX PREVIEW:\n", text.substring(0, 1000));

                // Split by STMTTRN allowing optional spaces
                const blocks = text.split(/<STMTTRN\s*>/i);
                const lancamentos = [];

                console.log("OFX parser found blocks:", blocks.length - 1);

                for (let i = 1; i < blocks.length; i++) {
                    const block = blocks[i].split(/<\/STMTTRN\s*>/i)[0];
                    
                    const trntype = getTagValue(block, 'TRNTYPE');
                    const dtposted = getTagValue(block, 'DTPOSTED');
                    const trnamt = getTagValue(block, 'TRNAMT');
                    const memo = getTagValue(block, 'MEMO') || getTagValue(block, 'NAME') || 'Sem descrição';

                    if (!dtposted || !trnamt) {
                        console.warn(`Block ${i} missing DTPOSTED or TRNAMT:`, { dtposted, trnamt, memo });
                        continue;
                    }

                    // Extract date parts (ignoring space, time, or timezone)
                    const cleanDt = dtposted.replace(/\s/g, '');
                    if (cleanDt.length < 8) {
                        console.warn(`Block ${i} DTPOSTED is too short:`, cleanDt);
                        continue;
                    }
                    const year = cleanDt.substring(0, 4);
                    const month = cleanDt.substring(4, 6);
                    const day = cleanDt.substring(6, 8);
                    const dataIso = `${year}-${month}-${day}`;

                    const valorLimpo = trnamt.replace(/\s/g, '').replace(',', '.');
                    const valor = parseFloat(valorLimpo);
                    if (isNaN(valor)) {
                        console.warn(`Block ${i} TRNAMT is not a number:`, trnamt);
                        continue;
                    }

                    const tipo = (valor < 0 || (trntype && trntype.toUpperCase() === 'DEBIT')) ? 2 : 1;

                    lancamentos.push({
                        data: dataIso,
                        descricao: memo,
                        valor: Math.abs(valor),
                        tipo: tipo
                    });
                }

                console.log("OFX parser extracted lancamentos:", lancamentos);

                if (lancamentos.length === 0) {
                    Swal.fire('Aviso', 'Nenhum lançamento válido foi encontrado no arquivo OFX.', 'warning');
                }

                parsedLancamentos = lancamentos;
                verificarDuplicadosEDisplay();
            } catch (err) {
                console.error("Erro no processamento do OFX:", err);
                Swal.fire('Erro', 'Erro ao processar o arquivo OFX: ' + err.message, 'error');
                processingStatus.classList.add('d-none');
            }
        }

        function getTagValue(block, tag) {
            // Match tag with optional spaces inside tag brackets, matching up to next opening bracket
            const regex = new RegExp('<' + tag + '\\s*>([^<]*)', 'i');
            const match = block.match(regex);
            return match ? match[1].trim() : '';
        }

        async function verificarDuplicadosEDisplay() {
            if (parsedLancamentos.length === 0) {
                displayResults([]);
                processingStatus.classList.add('d-none');
                resultsContainer.classList.remove('d-none');
                return;
            }

            const contaId = parseInt(globalConta.value);
            if (isNaN(contaId)) {
                displayResults(parsedLancamentos.map(l => ({ ...l, status: 'novo' })));
                processingStatus.classList.add('d-none');
                resultsContainer.classList.remove('d-none');
                return;
            }

            processingStatus.classList.remove('d-none');
            document.getElementById('status-text').innerText = "Verificando lançamentos duplicados...";
            resultsContainer.classList.add('d-none');

            try {
                const dtos = parsedLancamentos.map(l => ({
                    Data: l.data,
                    Valor: l.valor,
                    Tipo: l.tipo
                }));

                const response = await fetch('@Url.Action("VerificarDuplicados", "Lancamentos")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify({
                        ContaId: contaId,
                        Lancamentos: dtos
                    })
                });

                const result = await response.json();
                if (result.success && result.resultados) {
                    const lancamentosComStatus = parsedLancamentos.map((l, idx) => ({
                        ...l,
                        status: result.resultados[idx].status,
                        descricaoDb: result.resultados[idx].descricaoDb
                    }));
                    displayResults(lancamentosComStatus);
                } else {
                    displayResults(parsedLancamentos.map(l => ({ ...l, status: 'novo' })));
                }
            } catch (error) {
                console.error("Erro ao verificar duplicados:", error);
                displayResults(parsedLancamentos.map(l => ({ ...l, status: 'novo' })));
            } finally {
                processingStatus.classList.add('d-none');
                resultsContainer.classList.remove('d-none');
            }
        }

        function displayResults(lancamentos) {
            importTbody.innerHTML = '';
            document.getElementById('item-count').innerText = `${lancamentos.length} itens`;
            
            if (lancamentos.length === 0) {
                importTbody.innerHTML = '<tr><td colspan="9" class="text-center p-4">Nenhum lançamento válido encontrado no arquivo.</td></tr>';
                return;
            }

            const chkSelectAll = document.getElementById('chk-select-all');
            if (chkSelectAll) {
                chkSelectAll.checked = lancamentos.some(l => l.status === 'novo');
            }

            lancamentos.forEach((l, index) => {
                const row = document.createElement('tr');
                if (l.status === 'duplicado') {
                    row.classList.add('table-warning-bg');
                }
                
                row.innerHTML = `
                    <td class="text-center">
                        <input type="checkbox" class="form-check-input item-select" ${l.status === 'novo' ? 'checked' : ''}>
                    </td>
                    <td><input type="date" class="form-control form-control-sm item-data bg-light" value="${l.data}" readonly tabindex="-1"></td>
                    <td><input type="text" class="form-control form-control-sm item-descricao" value="${l.descricao}" list="lista-descricoes" autocomplete="off"></td>
                    <td>
                        <div class="input-group input-group-sm">
                            <span class="input-group-text bg-light">R$</span>
                            <input type="number" step="0.01" class="form-control item-valor bg-light" value="${l.valor.toFixed(2)}" readonly tabindex="-1">
                        </div>
                    </td>
                    <td>
                        <select class="form-select form-select-sm item-tipo bg-light" disabled tabindex="-1">
                            <option value="1" ${l.tipo === 1 ? 'selected' : ''}>Entrada</option>
                            <option value="2" ${l.tipo === 2 ? 'selected' : ''}>Saída</option>
                        </select>
                    </td>
                    <td>
                        <select class="form-select form-select-sm item-categoria">
                            ${tplCategoria.innerHTML}
                        </select>
                    </td>
                    <td>
                        ${l.status === 'duplicado' 
                            ? `<span class="badge bg-warning text-dark" title="Já cadastrado na base: ${l.descricaoDb || ''}"><i class="bi bi-exclamation-triangle-fill me-1"></i>Duplicado</span>` 
                            : '<span class="badge bg-success"><i class="bi bi-check-circle-fill me-1"></i>Falta Lançar</span>'}
                    </td>
                    <td class="text-center">
                        <button type="button" class="btn btn-outline-danger btn-sm btn-remove-row" title="Excluir Linha" tabindex="-1">
                            <i class="bi bi-trash"></i>
                        </button>
                    </td>
                `;
                
                row.querySelector('.btn-remove-row').addEventListener('click', () => {
                    row.remove();
                    updateCount();
                });
                
                importTbody.appendChild(row);
            });
        }

        function updateCount() {
            const count = importTbody.querySelectorAll('tr').length;
            document.getElementById('item-count').innerText = `${count} itens`;
            if (count === 0) {
                resultsContainer.classList.add('d-none');
            }
        }

        const chkSelectAll = document.getElementById('chk-select-all');
        if (chkSelectAll) {
            chkSelectAll.addEventListener('change', (e) => {
                const checked = e.target.checked;
                importTbody.querySelectorAll('.item-select').forEach(cb => {
                    cb.checked = checked;
                });
            });
        }

        globalConta.addEventListener('change', () => {
            if (parsedLancamentos.length > 0) {
                verificarDuplicadosEDisplay();
            }
        });

        document.querySelectorAll('input[name="csvSeparator"]').forEach(radio => {
            radio.addEventListener('change', () => {
                if (rawFileText && currentFileName.endsWith('.csv')) {
                    parseCsv(rawFileText);
                }
            });
        });

        document.getElementById('btn-clear-all').addEventListener('click', () => {
            Swal.fire({
                title: 'Tem certeza?',
                text: "Isso removerá todos os itens da lista.",
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#d33',
                cancelButtonColor: '#3085d6',
                confirmButtonText: 'Sim, limpar!',
                cancelButtonText: 'Cancelar'
            }).then((result) => {
                if (result.isConfirmed) {
                    importTbody.innerHTML = '';
                    parsedLancamentos = [];
                    updateCount();
                }
            });
        });

        document.getElementById('btn-save-all').addEventListener('click', async () => {
            const rows = importTbody.querySelectorAll('tr');
            if (rows.length === 0) return;
            
            const contaId = parseInt(globalConta.value);
            if (isNaN(contaId)) {
                Swal.fire('Aviso', 'Por favor, selecione a conta de destino.', 'warning');
                return;
            }

            const lancamentos = [];
            rows.forEach(row => {
                const chk = row.querySelector('.item-select');
                if (chk && chk.checked) {
                    lancamentos.push({
                        Data: row.querySelector('.item-data').value,
                        Descricao: row.querySelector('.item-descricao').value,
                        Valor: parseFloat(row.querySelector('.item-valor').value),
                        Tipo: parseInt(row.querySelector('.item-tipo').value),
                        CategoriaId: parseInt(row.querySelector('.item-categoria').value),
                        ContaId: contaId
                    });
                }
            });

            if (lancamentos.length === 0) {
                Swal.fire('Aviso', 'Por favor, selecione pelo menos um lançamento para salvar.', 'warning');
                return;
            }

            const btn = document.getElementById('btn-save-all');
            const originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status"></span>Salvando...';

            try {
                const response = await fetch('@Url.Action("SalvarLancamentosImportados", "Lancamentos")', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json',
                        'RequestVerificationToken': document.querySelector('input[name="__RequestVerificationToken"]').value
                    },
                    body: JSON.stringify(lancamentos)
                });

                const result = await response.json();
                if (result.success) {
                    Swal.fire('Sucesso!', result.message, 'success').then(() => {
                        $('#mainModal').modal('hide');
                        if (typeof Filtrar === 'function') {
                            Filtrar();
                        } else {
                            window.location.href = '@Url.Action("Index", "Lancamentos")';
                        }
                    });
                } else {
                    Swal.fire('Erro', result.message, 'error');
                }
            } catch (error) {
                Swal.fire('Erro', 'Erro ao enviar dados para o servidor: ' + error.message, 'error');
            } finally {
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        });
    })();
</script>

<style>
    .cursor-pointer { cursor: pointer; }
    #drop-zone:hover { border-color: #0d6efd !important; background-color: rgba(13, 110, 253, 0.05) !important; }
    .border-dashed { border-style: dashed !important; }
    .table input, .table select { border: 1px solid #ced4da; }
    .table input:focus, .table select:focus { border: 1px solid #86b7fe; box-shadow: 0 0 0 0.25rem rgba(13, 110, 253, 0.25); }
    .sticky-top { background-color: #fff; z-index: 1020; }
    .table-warning-bg { background-color: rgba(255, 193, 7, 0.07) !important; }
</style>
