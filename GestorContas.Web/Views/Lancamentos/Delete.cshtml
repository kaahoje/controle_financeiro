@model GestorContas.Web.Models.Lancamento
@using GestorContas.Web.Models.Enums

@{
    ViewData["Title"] = "Excluir Lançamento";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-danger">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0">
                        <i class="bi bi-exclamation-triangle-fill"></i> Confirmar Exclusão
                    </h3>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning" role="alert">
                        <i class="bi bi-info-circle-fill"></i>
                        <strong>Atenção!</strong> Você está prestes a excluir este lançamento. Esta ação não pode ser desfeita.
                    </div>

                    <div class="card bg-light mb-4">
                        <div class="card-body">
                            <h5 class="card-title text-primary mb-3">Detalhes do Lançamento</h5>
                            
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <label class="text-muted small fw-bold">
                                            <i class="bi bi-card-text"></i> Descrição
                                        </label>
                                        <p class="mb-0 fw-semibold">@Model.Descricao</p>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <label class="text-muted small fw-bold">
                                            <i class="bi bi-calendar-event"></i> Data
                                        </label>
                                        <p class="mb-0">
                                            <span class="badge bg-secondary">
                                                @Model.Data.ToString("dd/MM/yyyy")
                                            </span>
                                        </p>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <label class="text-muted small fw-bold">
                                            <i class="bi bi-arrow-left-right"></i> Tipo
                                        </label>
                                        <p class="mb-0">
                                            @if (Model.Tipo == TipoLancamento.Entrada)
                                            {
                                                <span class="badge bg-success">
                                                    <i class="bi bi-arrow-up"></i> Entrada
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger">
                                                    <i class="bi bi-arrow-down"></i> Saída
                                                </span>
                                            }
                                        </p>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="detail-item">
                                        <label class="text-muted small fw-bold">
                                            <i class="bi bi-currency-dollar"></i> Valor
                                        </label>
                                        <p class="mb-0">
                                            <span class="fs-5 fw-bold @(Model.Tipo == TipoLancamento.Entrada ? "text-success" : "text-danger")">
                                                @Model.Valor.ToString("C")
                                            </span>
                                        </p>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="detail-item">
                                        <label class="text-muted small fw-bold">
                                            <i class="bi bi-tag"></i> Categoria
                                        </label>
                                        <p class="mb-0">
                                            <span class="badge bg-info">
                                                @Model.Categoria?.Nome
                                            </span>
                                        </p>
                                    </div>
                                </div>

                                <div class="col-12">
                                    <div class="detail-item">
                                        <label class="text-muted small fw-bold">
                                            <i class="bi bi-wallet2"></i> Conta
                                        </label>
                                        <p class="mb-0">
                                            <span class="badge bg-warning text-dark">
                                                @Model.Conta?.Nome
                                            </span>
                                        </p>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        
                        <hr class="my-4">

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                            <button type="submit" class="btn btn-danger btn-lg">
                                <i class="bi bi-trash"></i> Confirmar Exclusão
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <style>
        .detail-item {
            padding: 0.75rem;
            border-left: 3px solid #0d6efd;
            background-color: white;
            border-radius: 0.25rem;
        }
    </style>
}
