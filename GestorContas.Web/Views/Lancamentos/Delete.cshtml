@model GestorContas.Web.Models.Lancamento
@using GestorContas.Web.Models.Enums

@{
    ViewData["Title"] = "Excluir Lançamento";
}

@if (Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
{
    <div>
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-info-circle-fill"></i>
            Deseja realmente excluir o lançamento: <strong>@Model.Descricao</strong>?
        </div>
        <div class="card bg-light mb-3">
            <div class="card-body">
                <p class="mb-1"><strong>Valor:</strong> <span class="@(Model.Tipo == TipoLancamento.Entrada ? "text-success" : "text-danger") fw-bold">@Model.Valor.ToString("C")</span></p>
                <p class="mb-1"><strong>Data:</strong> @Model.Data.ToString("dd/MM/yyyy")</p>
                <p class="mb-0"><strong>Conta:</strong> @Model.Conta?.Nome</p>
            </div>
        </div>
        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex justify-content-end">
                <button type="button" class="btn btn-outline-secondary me-2" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-danger">Confirmar Exclusão</button>
            </div>
        </form>
    </div>
}
else
{
    <div class="container">
        <!-- Full view content... same as original -->
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-lg border-danger">
                    <div class="card-header bg-danger text-white">
                        <h3 class="mb-0"><i class="bi bi-exclamation-triangle-fill"></i> Confirmar Exclusão</h3>
                    </div>
                    <div class="card-body p-4">
                        <div class="alert alert-warning" role="alert">
                            <strong>Atenção!</strong> Você está prestes a excluir este lançamento. Esta ação não pode ser desfeita.
                        </div>
                        <div class="card bg-light mb-4">
                            <div class="card-body">
                                <h5 class="card-title text-primary mb-3">Detalhes do Lançamento</h5>
                                <p><strong>Descrição:</strong> @Model.Descricao</p>
                                <p><strong>Valor:</strong> @Model.Valor.ToString("C")</p>
                                <p><strong>Data:</strong> @Model.Data.ToString("dd/MM/yyyy")</p>
                            </div>
                        </div>
                        <form asp-action="Delete" method="post">
                            <input type="hidden" asp-for="Id" />
                            <div class="d-flex justify-content-between">
                                <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Cancelar</a>
                                <button type="submit" class="btn btn-danger btn-lg">Confirmar Exclusão</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <style>
        .detail-item {
            padding: 0.75rem;
            border-left: 3px solid #0d6efd;
            background-color: white;
            border-radius: 0.25rem;
        }
    </style>
}
