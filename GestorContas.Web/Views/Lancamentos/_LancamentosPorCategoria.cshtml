@model GestorContas.Web.Models.ViewModels.LancamentosAgrupadosViewModel

<div class="modal-header bg-light">
    <h5 class="modal-title fw-bold">
        <i class="bi bi-tag-fill text-primary"></i> @Model.CategoriaNome
        <span class="ms-2 text-muted small fw-normal">Lançamentos detalhados</span>
    </h5>
    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
</div>
<div class="modal-body p-0">
    <div class="table-responsive">
        @foreach (var grupo in Model.GruposPorConta)
        {
            <div class="px-3 py-2 bg-light border-bottom border-top mt-3 first:mt-0">
                <div class="d-flex justify-content-between align-items-center">
                    <span class="fw-bold text-dark">
                        <i class="bi bi-bank me-1"></i> @grupo.ContaNome
                    </span>
                    <span class="badge bg-danger">
                        Total: @grupo.TotalConta.ToString("C")
                    </span>
                </div>
            </div>
            <table class="table table-sm table-hover mb-0">
                <thead class="bg-white">
                    <tr class="small text-muted text-uppercase">
                        <th class="ps-3 border-0">Data</th>
                        <th class="border-0">Descrição</th>
                        <th class="text-end pe-3 border-0">Valor</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var lancamento in grupo.Lancamentos)
                    {
                        <tr>
                            <td class="ps-3 small">@lancamento.Data.ToShortDateString()</td>
                            <td>@lancamento.Descricao</td>
                            <td class="text-end pe-3 fw-semibold @(lancamento.Tipo == GestorContas.Web.Models.Enums.TipoLancamento.Saida ? "text-danger" : "text-success")">
                                @(lancamento.Tipo == GestorContas.Web.Models.Enums.TipoLancamento.Saida ? "-" : "+") @lancamento.Valor.ToString("C")
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>
</div>
<div class="modal-footer bg-light d-flex justify-content-between align-items-center">
    <div>
        <span class="text-muted small text-uppercase fw-bold">Total Geral da Categoria:</span>
        <span class="fs-5 fw-bold text-danger ms-2">@Model.TotalGeral.ToString("C")</span>
    </div>
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fechar</button>
</div>

<style>
    .first\:mt-0:first-of-type {
        margin-top: 0 !important;
    }
</style>
