@model GestorContas.Web.Models.ViewModels.TransferenciaViewModel

@{
    ViewData["Title"] = "Transferência entre Contas";
}

@if (Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
{
    <div>
        <form asp-action="Transferencia" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <div class="row g-3">
                <div class="col-12">
                    <div class="form-floating">
                        <input asp-for="Descricao" class="form-control" placeholder="Descrição" autofocus />
                        <label asp-for="Descricao">Descrição (ex: Pix entre contas)</label>
                        <span asp-validation-for="Descricao" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="Valor" class="form-control" type="number" step="0.01" placeholder="0,00" />
                        <label asp-for="Valor">Valor</label>
                        <span asp-validation-for="Valor" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="Data" asp-format="{0:yyyy-MM-dd}" class="form-control" type="date" />
                        <label asp-for="Data">Data</label>
                        <span asp-validation-for="Data" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-floating">
                        <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.CategoriaId">
                            <option value="">Selecione uma categoria de transferência</option>
                        </select>
                        <label asp-for="CategoriaId">Categoria</label>
                        <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating">
                        <select asp-for="ContaSaidaId" class="form-select" asp-items="ViewBag.ContaId">
                            <option value="">Selecione a conta de origem</option>
                        </select>
                        <label asp-for="ContaSaidaId">Conta de Saída (Origem)</label>
                        <span asp-validation-for="ContaSaidaId" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating">
                        <select asp-for="ContaEntradaId" class="form-select" asp-items="ViewBag.ContaId">
                            <option value="">Selecione a conta de destino</option>
                        </select>
                        <label asp-for="ContaEntradaId">Conta de Entrada (Destino)</label>
                        <span asp-validation-for="ContaEntradaId" class="text-danger small"></span>
                    </div>
                </div>
            </div>
            <hr class="my-4">
            <div class="d-flex justify-content-end">
                <button type="button" class="btn btn-outline-secondary me-2" data-bs-dismiss="modal">Cancelar</button>
                <button type="submit" class="btn btn-primary">Realizar Transferência</button>
            </div>
        </form>
    </div>
}
else
{
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow border-primary">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0">Transferência entre Contas</h4>
                    </div>
                    <div class="card-body p-4">
                        <form asp-action="Transferencia" method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="form-floating">
                                        <input asp-for="Descricao" class="form-control" placeholder="Descrição" autofocus />
                                        <label asp-for="Descricao">Descrição</label>
                                        <span asp-validation-for="Descricao" class="text-danger small"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Valor" class="form-control" type="number" step="0.01" />
                                        <label asp-for="Valor">Valor</label>
                                        <span asp-validation-for="Valor" class="text-danger small"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Data" asp-format="{0:yyyy-MM-dd}" class="form-control" type="date" />
                                        <label asp-for="Data">Data</label>
                                        <span asp-validation-for="Data" class="text-danger small"></span>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-floating">
                                        <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.CategoriaId">
                                            <option value="">Selecione uma categoria de transferência</option>
                                        </select>
                                        <label asp-for="CategoriaId">Categoria</label>
                                        <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <select asp-for="ContaSaidaId" class="form-select" asp-items="ViewBag.ContaId">
                                            <option value="">Selecione a conta de origem</option>
                                        </select>
                                        <label asp-for="ContaSaidaId">Conta de Saída (Origem)</label>
                                        <span asp-validation-for="ContaSaidaId" class="text-danger small"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <select asp-for="ContaEntradaId" class="form-select" asp-items="ViewBag.ContaId">
                                            <option value="">Selecione a conta de destino</option>
                                        </select>
                                        <label asp-for="ContaEntradaId">Conta de Entrada (Destino)</label>
                                        <span asp-validation-for="ContaEntradaId" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                            <hr class="my-4">
                            <div class="d-flex justify-content-between">
                                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                                <button type="submit" class="btn btn-primary">Realizar Transferência</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
