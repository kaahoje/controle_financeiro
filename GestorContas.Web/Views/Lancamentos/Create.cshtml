@model GestorContas.Web.Models.Lancamento
@using GestorContas.Web.Models.Enums

@{
    ViewData["Title"] = "Novo Lançamento";
}

@if (Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
{
    <div>
        <form asp-action="Create" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            
            <div class="row g-3">
                <!-- Descrição -->
                <div class="col-12">
                    <div class="form-floating">
                        <input asp-for="Descricao" class="form-control" id="modal_descricao" placeholder="Descrição do lançamento" autofocus autocomplete="off" />
                        <label asp-for="Descricao"><i class="bi bi-card-text"></i> Descrição</label>
                        <span asp-validation-for="Descricao" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Valor -->
                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="Valor" class="form-control money-mask" id="modal_valor" placeholder="0,00" type="text" />
                        <label asp-for="Valor"><i class="bi bi-currency-dollar"></i> Valor</label>
                        <span asp-validation-for="Valor" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Data -->
                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="Data" asp-format="{0:yyyy-MM-dd}" class="form-control" id="modal_data" type="date" />
                        <label asp-for="Data"><i class="bi bi-calendar-event"></i> Data</label>
                        <span asp-validation-for="Data" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Tipo -->
                <div class="col-md-6">
                    <div class="form-floating">
                        <select asp-for="Tipo" class="form-select" id="modal_tipo">
                            <option value="">Selecione o tipo</option>
                            <option value="@((int)TipoLancamento.Entrada)">Entrada</option>
                            <option value="@((int)TipoLancamento.Saida)">Saída</option>
                        </select>
                        <label asp-for="Tipo"><i class="bi bi-arrow-left-right"></i> Tipo</label>
                        <span asp-validation-for="Tipo" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Categoria -->
                <div class="col-md-6">
                    <div class="form-floating">
                        <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.CategoriaId" id="modal_categoria">
                            <option value="">Selecione a categoria</option>
                        </select>
                        <label asp-for="CategoriaId"><i class="bi bi-tag"></i> Categoria</label>
                        <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Conta -->
                <div class="col-md-6">
                    <div class="form-floating">
                        <select asp-for="ContaId" class="form-select" asp-items="ViewBag.ContaId" id="modal_conta">
                            <option value="">Selecione a conta</option>
                        </select>
                        <label asp-for="ContaId"><i class="bi bi-wallet2"></i> Conta</label>
                        <span asp-validation-for="ContaId" class="text-danger small"></span>
                    </div>
                </div>
            </div>

            <hr class="my-4">

            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-success me-2">
                    <i class="bi bi-check-circle"></i> Salvar Lançamento
                </button>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </form>
    </div>
    <script>
        (function() {
            const tipoSelect = document.getElementById('modal_tipo');
            const valorInput = document.getElementById('modal_valor');
            if (tipoSelect) {
                tipoSelect.addEventListener('change', function() {
                    if (this.value == '@((int)TipoLancamento.Entrada)') {
                        valorInput.classList.remove('border-danger');
                        valorInput.classList.add('border-success');
                    } else if (this.value == '@((int)TipoLancamento.Saida)') {
                        valorInput.classList.remove('border-success');
                        valorInput.classList.add('border-danger');
                    }
                });
            }
        })();
    </script>
}
else
{
    <div class="container">
        <!-- Original Full View Content -->
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow-lg border-0">
                    <div class="card-header bg-success text-white">
                        <h3 class="mb-0"><i class="bi bi-plus-circle-fill"></i> Novo Lançamento</h3>
                    </div>
                    <div class="card-body p-4">
                        <form asp-action="Create" method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="form-floating">
                                        <input asp-for="Descricao" class="form-control" id="descricao" placeholder="Descrição do lançamento" autofocus autocomplete="off" />
                                        <label asp-for="Descricao"><i class="bi bi-card-text"></i> Descrição</label>
                                        <span asp-validation-for="Descricao" class="text-danger small"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Valor" class="form-control money-mask" id="valor" placeholder="0,00" type="text" />
                                        <label asp-for="Valor"><i class="bi bi-currency-dollar"></i> Valor</label>
                                        <span asp-validation-for="Valor" class="text-danger small"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Data" asp-format="{0:yyyy-MM-dd}" class="form-control" id="data" type="date" />
                                        <label asp-for="Data"><i class="bi bi-calendar-event"></i> Data</label>
                                        <span asp-validation-for="Data" class="text-danger small"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <select asp-for="Tipo" class="form-select" id="tipo">
                                            <option value="">Selecione o tipo</option>
                                            <option value="@((int)TipoLancamento.Entrada)">Entrada</option>
                                            <option value="@((int)TipoLancamento.Saida)">Saída</option>
                                        </select>
                                        <label asp-for="Tipo"><i class="bi bi-arrow-left-right"></i> Tipo</label>
                                        <span asp-validation-for="Tipo" class="text-danger small"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <select asp-for="CategoriaId" class="form-select" asp-items="ViewBag.CategoriaId" id="categoria">
                                            <option value="">Selecione a categoria</option>
                                        </select>
                                        <label asp-for="CategoriaId"><i class="bi bi-tag"></i> Categoria</label>
                                        <span asp-validation-for="CategoriaId" class="text-danger small"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <select asp-for="ContaId" class="form-select" asp-items="ViewBag.ContaId" id="conta">
                                            <option value="">Selecione a conta</option>
                                        </select>
                                        <label asp-for="ContaId"><i class="bi bi-wallet2"></i> Conta</label>
                                        <span asp-validation-for="ContaId" class="text-danger small"></span>
                                    </div>
                                </div>
                            </div>
                            <hr class="my-4">
                            <div class="d-flex justify-content-between">
                                <a asp-action="Index" class="btn btn-outline-secondary btn-lg"><i class="bi bi-arrow-left"></i> Cancelar</a>
                                <button type="submit" class="btn btn-success btn-lg"><i class="bi bi-check-circle"></i> Salvar Lançamento</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            // Adicionar feedback visual ao tipo de lançamento
            const tipoSelect = document.getElementById('tipo');
            tipoSelect.addEventListener('change', function() {
                const valorInput = document.getElementById('valor');
                if (this.value == '@((int)TipoLancamento.Entrada)') {
                    valorInput.classList.remove('border-danger');
                    valorInput.classList.add('border-success');
                } else if (this.value == '@((int)TipoLancamento.Saida)') {
                    valorInput.classList.remove('border-success');
                    valorInput.classList.add('border-danger');
                } else {
                    valorInput.classList.remove('border-success', 'border-danger');
                }
            });
        });
    </script>
}
