@model GestorContas.Web.Services.Diagnostico.Dtos.DiagnosticoFinanceiroDto
@{
    ViewData["Title"] = "Diagnóstico e Auditoria Financeira";
}

<div class="container-fluid py-3">
    <div class="d-flex justify-content-between align-items-center mb-4 pb-2 border-bottom">
        <div>
            <h2 class="h3 fw-bold text-dark mb-0 d-flex align-items-center">
                <i class="bi bi-search-heart text-primary me-2 fs-3"></i> Diagnóstico & Auditoria Financeira
            </h2>
            <p class="text-muted mb-0 small">Análise profunda de dados históricos, integridade de saldos, transferências e duplicidades.</p>
        </div>
        <div>
            <a href="@Url.Action("DiagnosticoJson", "Home")" target="_blank" class="btn btn-outline-secondary btn-sm">
                <i class="bi bi-filetype-json me-1"></i> Exportar Dados JSON
            </a>
            <a href="@Url.Action("Index", "Home")" class="btn btn-primary btn-sm ms-2">
                <i class="bi bi-house-door me-1"></i> Voltar à Home
            </a>
        </div>
    </div>

    <!-- CARDS RESUMO EXECUTIVO -->
    <div class="row g-3 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-primary text-white h-100">
                <div class="card-body">
                    <h6 class="text-white-50 text-uppercase small font-monospace">Saldo Real Acumulado</h6>
                    <h3 class="fw-bold mb-0">R$ @Model.ResumoGeral.SaldoAtualTotalSistema.ToString("N2")</h3>
                    <small class="text-white-50">Soma de todas as contas ativas</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm bg-success text-white h-100">
                <div class="card-body">
                    <h6 class="text-white-50 text-uppercase small font-monospace">Resultado Operacional Histórico</h6>
                    <h3 class="fw-bold mb-0">R$ @Model.ResumoGeral.ResultadoRealAcumulado.ToString("N2")</h3>
                    <small class="text-white-50">Entradas - Saídas (Excl. Transferências)</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm @(Model.ResumoGeral.TotalDuplicadosIdentificados > 0 ? "bg-warning text-dark" : "bg-light text-secondary") h-100">
                <div class="card-body">
                    <h6 class="text-uppercase small font-monospace @(Model.ResumoGeral.TotalDuplicadosIdentificados > 0 ? "text-dark-50" : "text-muted")">Duplicidades Suspeitas</h6>
                    <h3 class="fw-bold mb-0">@Model.ResumoGeral.TotalDuplicadosIdentificados registros</h3>
                    <small>Impacto em caixa: R$ @Model.ResumoGeral.ValorTotalDuplicados.ToString("N2")</small>
                </div>
            </div>
        </div>

        <div class="col-md-3">
            <div class="card border-0 shadow-sm @(Model.ResumoGeral.DesbalancoTransferencias != 0 || Model.TransferenciasAtipicas.Any() ? "bg-danger text-white" : "bg-info text-white") h-100">
                <div class="card-body">
                    <h6 class="text-white-50 text-uppercase small font-monospace">Desbalanço de Transferências</h6>
                    <h3 class="fw-bold mb-0">R$ @Model.ResumoGeral.DesbalancoTransferencias.ToString("N2")</h3>
                    <small class="text-white-50">@Model.TransferenciasAtipicas.Count transferências sem par correspondente</small>
                </div>
            </div>
        </div>
    </div>

    <!-- SEÇÕES DE ANÁLISE -->
    <div class="row g-4">

        <!-- 1. RESUMO POR CONTA E SALDO INICIAL -->
        <div class="col-12">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3 d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <h5 class="card-title fw-bold text-dark mb-0 d-flex align-items-center">
                        <i class="bi bi-wallet2 text-primary me-2"></i> 1. Balanço das Contas & Saldo Por Data de Corte
                    </h5>
                    <div class="d-flex align-items-center gap-2 bg-light p-2 rounded border">
                        <label for="inputDataCorte" class="small fw-bold text-muted mb-0 text-nowrap">
                            <i class="bi bi-calendar-check text-primary me-1"></i> Data de Corte:
                        </label>
                        <input type="date" id="inputDataCorte" class="form-control form-control-sm" value="@DateTime.Today.ToString("yyyy-MM-dd")" style="max-width: 150px;">
                        <button type="button" id="btnConsultarDataCorte" class="btn btn-primary btn-sm text-nowrap">
                            <i class="bi bi-funnel-fill me-1"></i> Consultar Saldo na Data
                        </button>
                        <button type="button" id="btnLimparDataCorte" class="btn btn-outline-secondary btn-sm text-nowrap" style="display:none;">
                            <i class="bi bi-x-circle me-1"></i> Ver Saldo Atual
                        </button>
                    </div>
                </div>
                <div class="card-body p-0">
                    <div id="alertaDataCorte" class="alert alert-info rounded-0 mb-0 py-2 px-3 small d-flex justify-content-between align-items-center" style="display:none;">
                        <span><i class="bi bi-info-circle-fill me-1"></i> Exibindo saldos acumulados apurados na data de corte: <strong id="lblDataCorteApurada"></strong></span>
                        <span class="badge bg-primary fs-6 font-monospace" id="lblTotalDataCorte"></span>
                    </div>
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th>Conta</th>
                                    <th class="text-end">Saldo Inicial</th>
                                    <th class="text-end">Entradas (Ops)</th>
                                    <th class="text-end">Saídas (Ops)</th>
                                    <th class="text-end">Transf. Entradas</th>
                                    <th class="text-end">Transf. Saídas</th>
                                    <th class="text-end fw-bold" id="thHeaderSaldo">Saldo Calculado Atual</th>
                                    <th>Primeiro Lançamento</th>
                                    <th>Último Lançamento</th>
                                </tr>
                            </thead>
                            <tbody id="tbodyDiagnosticoContas">
                                @foreach (var c in Model.DiagnosticoContas)
                                {
                                    <tr data-conta-id="@c.ContaId">
                                        <td class="fw-semibold">@c.NomeConta</td>
                                        <td class="text-end font-monospace">R$ @c.SaldoInicial.ToString("N2")</td>
                                        <td class="text-end text-success font-monospace col-ent">+R$ @c.TotalEntradas.ToString("N2")</td>
                                        <td class="text-end text-danger font-monospace col-sai">-R$ @c.TotalSaidas.ToString("N2")</td>
                                        <td class="text-end text-info font-monospace col-tent">+R$ @c.TotalTransferenciasRecebidas.ToString("N2")</td>
                                        <td class="text-end text-warning font-monospace col-tsai">-R$ @c.TotalTransferenciasEnviadas.ToString("N2")</td>
                                        <td class="text-end fw-bold font-monospace fs-6 col-saldo @(c.SaldoAtualCalculado >= 0 ? "text-primary" : "text-danger")">R$ @c.SaldoAtualCalculado.ToString("N2")</td>
                                        <td class="small text-muted">@(c.DataPrimeiroLancamento?.ToString("dd/MM/yyyy") ?? "-")</td>
                                        <td class="small text-muted">@(c.DataUltimoLancamento?.ToString("dd/MM/yyyy") ?? "-")</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 2. ANÁLISE DE EVOLUÇÃO MENSAL E CAIXA ACUMULADO -->
        <div class="col-lg-7">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3 d-flex justify-content-between align-items-center">
                    <h5 class="card-title fw-bold text-dark mb-0 d-flex align-items-center">
                        <i class="bi bi-graph-up-arrow text-success me-2"></i> 2. Evolução do Saldo Acumulado Mês a Mês
                    </h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                        <table class="table table-sm table-striped align-middle mb-0">
                            <thead class="table-light sticky-top">
                                <tr>
                                    <th>Mês/Ano</th>
                                    <th class="text-end">Entradas</th>
                                    <th class="text-end">Saídas</th>
                                    <th class="text-end">Resultado Mês</th>
                                    <th class="text-end font-monospace text-muted" title="Soma pura do Resultado do Mês partindo do Saldo Inicial (sem transferências)">Acumulado Teórico</th>
                                    <th class="text-end fw-bold" title="Saldo Real de Caixa considerando todas as entradas, saídas e transferências">Saldo Real (Extrato)</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr class="table-info">
                                    <td class="fw-bold"><i class="bi bi-flag-fill me-1"></i> Saldo Inicial das Contas</td>
                                    <td class="text-end font-monospace text-muted">-</td>
                                    <td class="text-end font-monospace text-muted">-</td>
                                    <td class="text-end font-monospace text-muted">-</td>
                                    <td class="text-end font-monospace text-muted">R$ @Model.ResumoGeral.SaldoInicialTotalContas.ToString("N2")</td>
                                    <td class="text-end font-monospace fw-bold text-primary">R$ @Model.ResumoGeral.SaldoInicialTotalContas.ToString("N2")</td>
                                </tr>
                                @foreach (var m in Model.EvolucaoMensal)
                                {
                                    <tr class="cursor-pointer btn-ver-detalhes-mes" data-mes-ano="@m.MesAnoLabel" data-json='@Html.Raw(System.Text.Json.JsonSerializer.Serialize(m.LancamentosMes))'>
                                        <td class="fw-semibold text-primary"><i class="bi bi-search me-1 small"></i>@m.MesAnoLabel</td>
                                        <td class="text-end text-success font-monospace">R$ @m.EntradasOperacionais.ToString("N2")</td>
                                        <td class="text-end text-danger font-monospace">R$ @m.SaidasOperacionais.ToString("N2")</td>
                                        <td class="text-end font-monospace fw-bold @(m.ResultadoOperacionalMes >= 0 ? "text-success" : "text-danger")">
                                            R$ @m.ResultadoOperacionalMes.ToString("N2")
                                        </td>
                                        <td class="text-end font-monospace text-secondary">
                                            R$ @m.SaldoAcumuladoResultadoMes.ToString("N2")
                                        </td>
                                        <td class="text-end font-monospace fw-bold @(m.SaldoAcumuladoFimMes >= 0 ? "text-primary" : "text-danger")">
                                            R$ @m.SaldoAcumuladoFimMes.ToString("N2")
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>

        <!-- 3. SUSPEITAS DE DUPLICIDADE HISTÓRICA -->
        <div class="col-lg-5">
            <div class="card shadow-sm border-0 h-100">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title fw-bold text-dark mb-0 d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill text-warning me-2"></i> 3. Registros Duplicados na Base (@Model.DuplicadosSuspeitos.Count)
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (!Model.DuplicadosSuspeitos.Any())
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="bi bi-shield-check fs-1 text-success"></i>
                            <p class="mb-0 mt-2">Nenhum registro duplicado foi identificado!</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                            <table class="table table-sm table-hover mb-0 align-middle">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>Data</th>
                                        <th>Conta</th>
                                        <th>Valor</th>
                                        <th>Qtd</th>
                                        <th>IDs</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var d in Model.DuplicadosSuspeitos)
                                    {
                                        <tr>
                                            <td class="small">@d.Data.ToString("dd/MM/yyyy")</td>
                                            <td class="small">@d.ContaNome</td>
                                            <td class="font-monospace fw-bold @(d.Tipo == "Entrada" ? "text-success" : "text-danger")">R$ @d.Valor.ToString("N2")</td>
                                            <td><span class="badge bg-warning text-dark">@d.QuantidadeDuplicados x</span></td>
                                            <td class="small text-muted font-monospace">#@string.Join(", #", d.LancamentosIds)</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- 4. ALERTAS DE ERRO DE SINAL / TIPO -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title fw-bold text-dark mb-0 d-flex align-items-center">
                        <i class="bi bi-arrow-left-right text-danger me-2"></i> 4. Suspeitas de Inversão de Sinal / Tipo (@Model.ErrosSinalOuTipo.Count)
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (!Model.ErrosSinalOuTipo.Any())
                    {
                        <div class="p-4 text-center text-muted">
                            <i class="bi bi-check-circle fs-3 text-success"></i>
                            <p class="mb-0 mt-1">Nenhuma divergência óbvia de palavras-chave x tipo.</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive" style="max-height: 350px; overflow-y: auto;">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>ID</th>
                                        <th>Data</th>
                                        <th>Descrição</th>
                                        <th>Tipo Atual</th>
                                        <th>Valor</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var e in Model.ErrosSinalOuTipo)
                                    {
                                        <tr>
                                            <td>#@e.Id</td>
                                            <td class="small">@e.Data.ToString("dd/MM/yyyy")</td>
                                            <td class="small">@e.Descricao</td>
                                            <td><span class="badge @(e.Tipo == "Entrada" ? "bg-success" : "bg-danger")">@e.Tipo</span></td>
                                            <td class="font-monospace fw-bold">R$ @e.Valor.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- 5. TRANSFERÊNCIAS DESBALANCEADAS -->
        <div class="col-lg-6">
            <div class="card shadow-sm border-0">
                <div class="card-header bg-white py-3">
                    <h5 class="card-title fw-bold text-dark mb-0 d-flex align-items-center">
                        <i class="bi bi-box-arrow-up-right text-info me-2"></i> 5. Transferências Sem Contrapartida (@Model.TransferenciasAtipicas.Count)
                    </h5>
                </div>
                <div class="card-body p-0">
                    @if (!Model.TransferenciasAtipicas.Any())
                    {
                        <div class="p-4 text-center text-muted">
                            <i class="bi bi-check-circle fs-3 text-success"></i>
                            <p class="mb-0 mt-1">Todas as transferências possuem par perfeito entre contas!</p>
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive" style="max-height: 350px; overflow-y: auto;">
                            <table class="table table-sm table-hover mb-0">
                                <thead class="table-light sticky-top">
                                    <tr>
                                        <th>ID</th>
                                        <th>Data</th>
                                        <th>Conta</th>
                                        <th>Descrição</th>
                                        <th>Tipo</th>
                                        <th>Valor</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var t in Model.TransferenciasAtipicas)
                                    {
                                        <tr>
                                            <td>#@t.Id</td>
                                            <td class="small">@t.Data.ToString("dd/MM/yyyy")</td>
                                            <td class="small">@t.ContaNome</td>
                                            <td class="small">@t.Descricao</td>
                                            <td><span class="badge @(t.Tipo == "Entrada" ? "bg-success" : "bg-danger")">@t.Tipo</span></td>
                                            <td class="font-monospace fw-bold">R$ @t.Valor.ToString("N2")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Modal Detalhes do Mês -->
<div class="modal fade" id="modalDetalhesMes" tabindex="-1" aria-labelledby="modalDetalhesMesLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl modal-dialog-scrollable">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white py-2">
                <h5 class="modal-title fs-6 fw-bold" id="modalDetalhesMesLabel">
                    <i class="bi bi-calendar-event me-2"></i> Lançamentos e Transferências de <span id="modalMesTitulo"></span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body p-0">
                <div class="p-3 bg-light border-bottom d-flex gap-2 align-items-center">
                    <input type="text" id="filtroModalTexto" class="form-control form-control-sm" placeholder="Filtrar por descrição, conta ou categoria...">
                    <select id="filtroModalTipo" class="form-select form-select-sm" style="max-width: 180px;">
                        <option value="">Todos os tipos</option>
                        <option value="Entrada">Entradas</option>
                        <option value="Saída">Saídas</option>
                        <option value="Transferência">Apenas Transferências</option>
                    </select>
                    <div class="form-check form-switch mb-0 ms-2 text-nowrap">
                        <input class="form-check-input" type="checkbox" id="chkAgruparTipo">
                        <label class="form-check-label small fw-semibold" for="chkAgruparTipo">Agrupar por Tipo</label>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-sm table-hover align-middle mb-0">
                        <thead class="table-dark">
                            <tr>
                                <th>#ID</th>
                                <th>Data</th>
                                <th>Conta</th>
                                <th>Descrição</th>
                                <th>Categoria</th>
                                <th>Tipo</th>
                                <th class="text-end">Valor</th>
                            </tr>
                        </thead>
                        <tbody id="tbodyDetalhesMes">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        let lancamentosAtuais = [];

        document.querySelectorAll('.btn-ver-detalhes-mes').forEach(row => {
            row.addEventListener('click', function () {
                const mesAno = this.getAttribute('data-mes-ano');
                const rawJson = this.getAttribute('data-json');
                
                try {
                    lancamentosAtuais = JSON.parse(rawJson);
                } catch (e) {
                    lancamentosAtuais = [];
                }

                document.getElementById('modalMesTitulo').innerText = mesAno;
                renderizarLancamentosModal();
                
                const modal = new bootstrap.Modal(document.getElementById('modalDetalhesMes'));
                modal.show();
            });
        });

        document.getElementById('filtroModalTexto').addEventListener('input', renderizarLancamentosModal);
        document.getElementById('filtroModalTipo').addEventListener('change', renderizarLancamentosModal);
        document.getElementById('chkAgruparTipo').addEventListener('change', renderizarLancamentosModal);

        function renderizarLancamentosModal() {
            const tbody = document.getElementById('tbodyDetalhesMes');
            const term = document.getElementById('filtroModalTexto').value.toLowerCase();
            const tipoFiltro = document.getElementById('filtroModalTipo').value;
            const agrupar = document.getElementById('chkAgruparTipo').checked;

            tbody.innerHTML = '';

            const filtrados = lancamentosAtuais.filter(l => {
                const textMatch = !term || 
                    (l.Descricao && l.Descricao.toLowerCase().includes(term)) ||
                    (l.ContaNome && l.ContaNome.toLowerCase().includes(term)) ||
                    (l.CategoriaNome && l.CategoriaNome.toLowerCase().includes(term));

                let tipoMatch = true;
                if (tipoFiltro === 'Entrada') tipoMatch = l.Tipo === 'Entrada';
                else if (tipoFiltro === 'Saída') tipoMatch = l.Tipo === 'Saída';
                else if (tipoFiltro === 'Transferência') tipoMatch = l.IsTransferencia;

                return textMatch && tipoMatch;
            });

            if (filtrados.length === 0) {
                tbody.innerHTML = '<tr><td colspan="7" class="text-center text-muted p-4">Nenhum lançamento encontrado para os filtros selecionados.</td></tr>';
                return;
            }

            if (!agrupar) {
                renderizarLinhas(filtrados, tbody);
            } else {
                // Agrupar estritamente em ENTRADAS (Operacionais + Transferências de Entrada) e SAÍDAS (Operacionais + Transferências de Saída)
                const grupos = [
                    { 
                        titulo: '🟢 TODAS AS ENTRADAS DO MÊS', 
                        classe: 'table-success', 
                        items: filtrados.filter(x => x.Tipo === 'Entrada'),
                        subgrupos: [
                            { nome: 'Entradas Operacionais', items: filtrados.filter(x => x.Tipo === 'Entrada' && !x.IsTransferencia) },
                            { nome: 'Transferências Recebidas', items: filtrados.filter(x => x.Tipo === 'Entrada' && x.IsTransferencia) }
                        ]
                    },
                    { 
                        titulo: '🔴 TODAS AS SAÍDAS DO MÊS', 
                        classe: 'table-danger', 
                        items: filtrados.filter(x => x.Tipo === 'Saída'),
                        subgrupos: [
                            { nome: 'Saídas Operacionais (Despesas)', items: filtrados.filter(x => x.Tipo === 'Saída' && !x.IsTransferencia) },
                            { nome: 'Transferências Enviadas', items: filtrados.filter(x => x.Tipo === 'Saída' && x.IsTransferencia) }
                        ]
                    }
                ];

                grupos.forEach(g => {
                    if (g.items.length > 0) {
                        const totalGrupo = g.items.reduce((acc, curr) => acc + curr.Valor, 0);
                        const headerTr = document.createElement('tr');
                        headerTr.className = `${g.classe} fw-bold border-top border-dark`;
                        headerTr.innerHTML = `
                            <td colspan="6" class="fs-6">${g.titulo} (${g.items.length} lançamentos)</td>
                            <td class="text-end font-monospace fs-6">R$ ${totalGrupo.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}</td>
                        `;
                        tbody.appendChild(headerTr);

                        g.subgrupos.forEach(sub => {
                            if (sub.items.length > 0) {
                                const totalSub = sub.items.reduce((acc, curr) => acc + curr.Valor, 0);
                                const subHeaderTr = document.createElement('tr');
                                subHeaderTr.className = 'table-light text-muted small fw-semibold';
                                subHeaderTr.innerHTML = `
                                    <td colspan="6" class="ps-4">↳ ${sub.nome} (${sub.items.length})</td>
                                    <td class="text-end font-monospace">R$ ${totalSub.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}</td>
                                `;
                                tbody.appendChild(subHeaderTr);
                                renderizarLinhas(sub.items, tbody);
                            }
                        });
                    }
                });
            }
        }

        function renderizarLinhas(lista, tbody) {
            lista.forEach(l => {
                const tr = document.createElement('tr');
                const dataFmt = l.Data ? l.Data.split('T')[0].split('-').reverse().join('/') : '';
                const valorFmt = l.Valor ? l.Valor.toLocaleString('pt-BR', { minimumFractionDigits: 2 }) : '0,00';
                
                tr.innerHTML = `
                    <td class="small text-muted font-monospace">#${l.Id}</td>
                    <td class="small">${dataFmt}</td>
                    <td class="fw-semibold small">${l.ContaNome}</td>
                    <td>${l.Descricao}</td>
                    <td>
                        <span class="badge ${l.IsTransferencia ? 'bg-info text-dark' : 'bg-light text-dark border'}">
                            ${l.CategoriaNome}
                        </span>
                    </td>
                    <td>
                        <span class="badge ${l.Tipo === 'Entrada' ? 'bg-success' : 'bg-danger'}">
                            ${l.Tipo}
                        </span>
                    </td>
                    <td class="text-end font-monospace fw-bold ${l.Tipo === 'Entrada' ? 'text-success' : 'text-danger'}">
                        R$ ${valorFmt}
                    </td>
                `;
                tbody.appendChild(tr);
            });
        }

        // Manipulação da Consulta por Data de Corte
        const btnConsultar = document.getElementById('btnConsultarDataCorte');
        const btnLimpar = document.getElementById('btnLimparDataCorte');
        const inputData = document.getElementById('inputDataCorte');
        const alerta = document.getElementById('alertaDataCorte');

        if (btnConsultar) {
            btnConsultar.addEventListener('click', function () {
                const dataVal = inputData.value;
                if (!dataVal) return;

                btnConsultar.disabled = true;
                btnConsultar.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Calculando...';

                fetch(`@Url.Action("ObterSaldoDataCorteJson", "Home")?dataCorte=${dataVal}`)
                    .then(r => r.json())
                    .then(res => {
                        document.getElementById('lblDataCorteApurada').innerText = res.dataCorte || res.DataCorte;
                        document.getElementById('lblTotalDataCorte').innerText = `Total Geral em ${res.dataCorte || res.DataCorte}: R$ ${(res.totalGeral || res.TotalGeral).toLocaleString('pt-BR', { minimumFractionDigits: 2 })}`;
                        document.getElementById('thHeaderSaldo').innerText = `Saldo na Data (${res.dataCorte || res.DataCorte})`;
                        alerta.style.display = 'flex';
                        btnLimpar.style.display = 'inline-block';

                        const listaContas = res.contas || res.Contas;
                        listaContas.forEach(c => {
                            const contaId = c.id || c.Id;
                            const ent = c.totalEntradas || c.TotalEntradas || 0;
                            const sai = c.totalSaidas || c.TotalSaidas || 0;
                            const saldo = c.saldoNaData || c.SaldoNaData || 0;

                            const tr = document.querySelector(`tr[data-conta-id="${contaId}"]`);
                            if (tr) {
                                tr.querySelector('.col-ent').innerText = `+R$ ${ent.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}`;
                                tr.querySelector('.col-sai').innerText = `-R$ ${sai.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}`;
                                tr.querySelector('.col-tent').innerText = `-`;
                                tr.querySelector('.col-tsai').innerText = `-`;

                                const colSaldo = tr.querySelector('.col-saldo');
                                colSaldo.innerText = `R$ ${saldo.toLocaleString('pt-BR', { minimumFractionDigits: 2 })}`;
                                colSaldo.className = `text-end fw-bold font-monospace fs-6 col-saldo ${saldo >= 0 ? 'text-primary' : 'text-danger'}`;
                            }
                        });
                    })
                    .catch(err => {
                        console.error(err);
                        alert('Erro ao calcular saldo na data de corte.');
                    })
                    .finally(() => {
                        btnConsultar.disabled = false;
                        btnConsultar.innerHTML = '<i class="bi bi-funnel-fill me-1"></i> Consultar Saldo na Data';
                    });
            });
        }

        if (btnLimpar) {
            btnLimpar.addEventListener('click', function () {
                window.location.reload();
            });
        }
    });
</script>
