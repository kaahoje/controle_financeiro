@model GestorContas.Web.Models.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
}

<div class="container-fluid">
    <div id="dashboardContainer">
        <!-- Header -->
        <div class="page-header d-flex flex-column mb-4 pb-3 border-bottom">
            <div class="header-title-container mb-3">
                <h2 class="h3 fw-bold text-dark mb-0 d-flex align-items-center">
                    <div class="icon-box bg-primary-subtle text-primary rounded-3 me-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                        <i class="bi bi-speedometer2 fs-4"></i>
                    </div>
                    <span>Dashboard Financeiro</span>
                </h2>
            </div>
            <div class="header-actions-container">
                <div class="d-flex flex-column gap-2">
                    <form id="formFiltroDashboard" method="get" asp-action="Index" class="d-flex flex-wrap gap-2 align-items-center">
                        <input type="hidden" name="mes" id="filtroMesDashboard" value="@ViewBag.MesSelecionado" />
                        
                        <div class="d-flex align-items-center gap-2 flex-wrap">
                            <div class="d-flex align-items-center me-2">
                                <label class="form-label fw-bold mb-0 me-2 small">Ano:</label>
                                <select name="ano" id="filtroAnoDashboard" class="form-select form-select-sm" style="min-width: 90px;">
                                    @for (int ano = DateTime.Today.Year; ano >= DateTime.Today.Year - 5; ano--)
                                    {
                                        <option value="@ano" selected="@(ViewBag.AnoSelecionado == ano)">@ano</option>
                                    }
                                </select>
                            </div>

                            <div class="btn-group btn-group-sm flex-wrap" role="group" aria-label="Seleção de mês">
                                @{
                                    var mesesAbrev = new[] { "Jan", "Fev", "Mar", "Abr", "Mai", "Jun", "Jul", "Ago", "Set", "Out", "Nov", "Dez" };
                                }
                                @for (int m = 1; m <= 12; m++)
                                {
                                    var ativo = ViewBag.MesSelecionado == m;
                                    <button type="button" 
                                            class="btn btn-sm btn-mes-filtro @(ativo ? "btn-primary active fw-bold" : "btn-outline-secondary")" 
                                            data-mes="@m">
                                        @mesesAbrev[m - 1]
                                    </button>
                                }
                            </div>
                        </div>                        
                    </form>

                    <p class="lead text-muted mb-0 mt-1">
                        Resumo financeiro de <strong>@Model.ResumoMensal.MesAno.ToString("MMMM/yyyy")</strong>
                    </p>
                </div>
            </div>
        </div>

        <!-- Cards de Resumo Mensal -->
        <div class="row mb-4 g-3">
            <div class="col-md-4">
                <div class="card shadow-sm border-success h-100">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase mb-2">Entradas do Mês</h6>
                        <div class="d-flex align-items-center">
                            <div class="display-6 fw-bold text-success me-3">
                                <i class="bi bi-arrow-up-circle"></i>
                            </div>
                            <div>
                                <h3 class="fw-bold mb-0 text-success">@Model.ResumoMensal.TotalEntradas.ToString("C")</h3>
                                <small class="text-muted">Acumulado em @Model.ResumoMensal.MesAno.ToString("MMMM")</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm border-danger h-100">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase mb-2">Saídas do Mês</h6>
                        <div class="d-flex align-items-center">
                            <div class="display-6 fw-bold text-danger me-3">
                                <i class="bi bi-arrow-down-circle"></i>
                            </div>
                            <div>
                                <h3 class="fw-bold mb-0 text-danger">@Model.ResumoMensal.TotalSaidas.ToString("C")</h3>
                                <small class="text-muted">Acumulado em @Model.ResumoMensal.MesAno.ToString("MMMM")</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-4">
                <div class="card shadow-sm border-primary h-100">
                    <div class="card-body">
                        <h6 class="text-muted text-uppercase mb-2">Balanço Mensal</h6>
                        <div class="d-flex align-items-center">
                            <div class="display-6 fw-bold @(Model.ResumoMensal.SaldoMensal >= 0 ? "text-primary" : "text-danger") me-3">
                                <i class="bi bi-wallet2"></i>
                            </div>
                            <div>
                                <h3 class="fw-bold mb-0 @(Model.ResumoMensal.SaldoMensal >= 0 ? "text-primary" : "text-danger")">
                                    @Model.ResumoMensal.SaldoMensal.ToString("C")
                                </h3>
                                <small class="text-muted">Resultado do período</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-4">
            <!-- Minhas Contas -->
            <div class="col-lg-4 mb-4 mb-lg-0">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white border-bottom-0 pt-3">
                        <h5 class="card-title fw-bold text-dark mb-0">
                            <i class="bi bi-bank"></i> Minhas Contas
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="list-group list-group-flush">
                            @foreach (var conta in Model.Contas)
                            {
                                <div class="list-group-item d-flex justify-content-between align-items-center py-3">
                                    <div>
                                        <h6 class="mb-0 fw-semibold">@conta.Nome</h6>
                                        @if (!string.IsNullOrEmpty(conta.Descricao))
                                        {
                                            <small class="text-muted">@conta.Descricao</small>
                                        }
                                    </div>
                                    <div class="text-end">
                                        <span class="fs-5 fw-bold @(conta.Saldo >= 0 ? "text-dark" : "text-danger")">
                                            @conta.Saldo.ToString("C")
                                        </span>
                                    </div>
                                </div>
                            }
                            <div class="list-group-item bg-light py-3">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h6 class="mb-0 fw-bold text-uppercase text-muted" style="font-size: 0.8rem;">Saldo Total</h6>
                                    <span class="fs-5 fw-bold @(Model.Contas.Sum(c => c.Saldo) >= 0 ? "text-success" : "text-danger")">
                                        @Model.Contas.Sum(c => c.Saldo).ToString("C")
                                    </span>
                                </div>
                                <div class="text-center">
                                    <a asp-controller="Contas" asp-action="Index" class="btn btn-sm btn-outline-primary w-100">
                                        Gerenciar Contas
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Gráficos -->
            <div class="col-lg-8">
                <div class="row g-4">
                    <div class="col-md-6">
                        <div class="card shadow-sm h-100">
                            <div class="card-header bg-white pt-3">
                                <h5 class="card-title fw-bold mb-0">@Model.GraficoFluxoCaixa.Titulo</h5>
                            </div>
                            <div class="card-body">
                                <canvas id="chartFluxoCaixa"></canvas>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="card shadow-sm h-100">
                            <div class="card-header bg-white pt-3">
                                <h5 class="card-title fw-bold mb-0">@Model.GraficoDespesas.Titulo</h5>
                            </div>
                            <div class="card-body">
                                @if (Model.GraficoDespesas.Valores != null && Model.GraficoDespesas.Valores.Any())
                                {
                                    <canvas id="chartDespesas"></canvas>
                                }
                                else
                                {
                                    <div class="text-center py-5 text-muted">
                                        <i class="bi bi-pie-chart display-4"></i>
                                        <p class="mt-2">Sem dados de despesas neste mês</p>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Gráfico Evolução de Saldo -->
        <div class="row mb-4">
            <div class="col-12">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-white pt-3">
                        <h5 class="card-title fw-bold mb-0">@Model.GraficoEvolucaoSaldo.Titulo</h5>
                    </div>
                    <div class="card-body">
                        <div style="height: 400px;">
                            <canvas id="chartEvolucaoSaldo"></canvas>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Tabela de Despesas por Categoria -->
        <div class="row">
            <div class="col-12">
                <div class="card shadow-sm">
                    <div class="card-header bg-white pt-3">
                        <h5 class="card-title fw-bold mb-0">
                            <i class="bi bi-list-ul"></i> Detalhamento de Despesas por Categoria
                        </h5>
                    </div>
                    <div class="card-body p-0">
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Categoria</th>
                                        <th class="text-end">Total Gasto</th>
                                        <th class="text-center" style="width: 200px;">Ações</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.DespesasPorCategoria)
                                    {
                                        <tr>
                                            <td class="ps-4">
                                                <span class="fw-semibold">@item.CategoriaNome</span>
                                            </td>
                                            <td class="text-end text-danger fw-bold">
                                                @item.Total.ToString("C")
                                            </td>
                                            <td class="text-center">
                                                <button type="button" 
                                                        class="btn btn-sm btn-outline-primary"
                                                        onclick="abrirDetalhes(@ViewBag.MesSelecionado, @ViewBag.AnoSelecionado, @item.CategoriaId)">
                                                    <i class="bi bi-eye"></i> Ver Lançamentos
                                                </button>
                                            </td>
                                        </tr>
                                    }
                                    @if (!Model.DespesasPorCategoria.Any())
                                    {
                                        <tr>
                                            <td colspan="3" class="text-center py-4 text-muted">
                                                Nenhuma despesa registrada para este período.
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                                @if (Model.DespesasPorCategoria.Any())
                                {
                                    <tfoot class="table-light fw-bold">
                                        <tr>
                                            <td class="ps-4 text-uppercase small text-muted">Total de Despesas</td>
                                            <td class="text-end text-danger">
                                                @Model.DespesasPorCategoria.Sum(x => x.Total).ToString("C")
                                            </td>
                                            <td></td>
                                        </tr>
                                    </tfoot>
                                }
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Modal para Detalhes de Lançamentos -->
    <div class="modal fade" id="modalDetalhes" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content border-0 shadow" id="modalContent">
                <div class="modal-body text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Carregando...</span>
                    </div>
                    <p class="mt-2 text-muted">Carregando detalhes...</p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">

    <script>
        // Configuração comum
        Chart.defaults.font.family = "'Segoe UI', 'Helvetica Neue', 'Helvetica', 'Arial', sans-serif";

        const brl = new Intl.NumberFormat('pt-BR', { style: 'currency', currency: 'BRL' });

        // Plugin para escrever valores em cima das barras
        const valueLabelPlugin = {
            id: 'valueLabelPlugin',
            afterDatasetsDraw(chart, args, pluginOptions) {
                const { ctx } = chart;
                ctx.save();

                const color = pluginOptions?.color ?? '#212529';
                const formatter = pluginOptions?.formatter ?? ((v) => String(v));

                chart.data.datasets.forEach((dataset, datasetIndex) => {
                    const meta = chart.getDatasetMeta(datasetIndex);
                    if (meta.hidden) return;

                    meta.data.forEach((element, index) => {
                        const value = dataset.data[index];
                        if (value === null || value === undefined) return;

                        const pos = element.tooltipPosition();
                        const text = formatter(value);

                        ctx.fillStyle = color;
                        ctx.textAlign = 'center';
                        ctx.textBaseline = 'bottom';
                        ctx.font = `12px ${Chart.defaults.font.family}`;
                        ctx.fillText(text, pos.x, pos.y - 6);
                    });
                });

                ctx.restore();
            }
        };

        Chart.register(valueLabelPlugin);

        // Gráfico Fluxo de Caixa
        const ctxFluxo = document.getElementById('chartFluxoCaixa');
        if (ctxFluxo) {
            window.chartFluxoCaixaInst = new Chart(ctxFluxo, {
                type: 'bar',
                data: {
                    labels: @Json.Serialize(Model.GraficoFluxoCaixa.Labels),
                    datasets: [{
                        label: 'Valor (R$)',
                        data: @Json.Serialize(Model.GraficoFluxoCaixa.Valores),
                        backgroundColor: @Json.Serialize(Model.GraficoFluxoCaixa.Cores),
                        borderRadius: 5,
                        barThickness: 50
                    }]
                },
                options: {
                    responsive: true,
                    plugins: {
                        legend: { display: false },
                        valueLabelPlugin: { formatter: (v) => brl.format(v) }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: '#f0f0f0' }
                        },
                        x: {
                            grid: { display: false }
                        }
                    }
                }
            });
        }

        // Gráfico Despesas por Categoria
        const ctxDespesas = document.getElementById('chartDespesas');
        if (ctxDespesas) {
            const despesasLabels = @Json.Serialize(Model.GraficoDespesas.Labels);
            const despesasValores = @Json.Serialize(Model.GraficoDespesas.Valores);
            const despesasCores = @Json.Serialize(Model.GraficoDespesas.Cores);

            // Ajusta altura para não "encostar" barras (1 barra por linha)
            const minHeight = 260;
            const rowHeight = 44; // altura por categoria (inclui espaçamento)
            const desiredHeight = Math.max(minHeight, (despesasLabels?.length ?? 0) * rowHeight);
            if (ctxDespesas.parentElement) {
                ctxDespesas.parentElement.style.height = `${desiredHeight}px`;
            }

            window.chartDespesasInst = new Chart(ctxDespesas, {
                type: 'bar',
                data: {
                    labels: despesasLabels,
                    datasets: [{
                        label: 'Total (R$)',
                        data: despesasValores,
                        backgroundColor: despesasCores,
                        borderRadius: 8,
                        // garante espaço entre barras (sem contato/sem sobreposição)
                        categoryPercentage: 0.72,
                        barPercentage: 0.78
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    indexAxis: 'y',
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: (context) => brl.format(context.parsed.x)
                            }
                        },
                        valueLabelPlugin: { formatter: (v) => brl.format(v) }
                    },
                    scales: {
                        x: {
                            beginAtZero: true,
                            grid: { color: '#f0f0f0' },
                            ticks: {
                                callback: (value) => brl.format(value)
                            }
                        },
                        y: {
                            grid: { display: false },
                            ticks: {
                                autoSkip: false
                            }
                        }
                    }
                }
            });
        }

        // Gráfico Evolução de Saldo
        const ctxEvolucao = document.getElementById('chartEvolucaoSaldo');
        if (ctxEvolucao) {
            window.chartEvolucaoSaldoInst = new Chart(ctxEvolucao, {
                type: 'line',
                data: {
                    labels: @Json.Serialize(Model.GraficoEvolucaoSaldo.Labels),
                    datasets: @Json.Serialize(Model.GraficoEvolucaoSaldo.Datasets)
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: {
                        legend: { position: 'bottom' },
                        tooltip: {
                            mode: 'index',
                            intersect: false,
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: false,
                            grid: { color: '#f0f0f0' }
                        },
                        x: {
                            grid: { display: false }
                        }
                    }
                }
            });
        }

        function abrirDetalhes(mes, ano, categoriaId) {
            const modalElement = document.getElementById('modalDetalhes');
            const modal = bootstrap.Modal.getOrCreateInstance(modalElement);
            const content = document.getElementById('modalContent');
            
            // Re-set initial state
            content.innerHTML = `
                <div class="modal-body text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Carregando...</span>
                    </div>
                    <p class="mt-2 text-muted">Carregando detalhes...</p>
                </div>`;
            
            modal.show();
            
            fetch(`/Lancamentos/GetLancamentosPorCategoria?mes=${mes}&ano=${ano}&categoriaId=${categoriaId}`)
                .then(response => response.text())
                .then(html => {
                    content.innerHTML = html;
                })
                .catch(error => {
                    content.innerHTML = `
                        <div class="modal-body text-center py-5 text-danger">
                            <i class="bi bi-exclamation-triangle display-4"></i>
                            <p class="mt-2">Erro ao carregar detalhes. Tente novamente.</p>
                            <button type="button" class="btn btn-secondary mt-3" data-bs-dismiss="modal">Fechar</button>
                        </div>`;
                });
        }

        // Auto-filtrar ao alterar mes (botoes) ou ano (select) no dashboard usando AJAX
        $(function() {
            let requisicaoEmAndamento = false;

            function carregarDashboard(formData) {
                if (requisicaoEmAndamento) return;
                requisicaoEmAndamento = true;

                const url = $('#formFiltroDashboard').attr('action') || window.location.pathname;

                $.get(url + '?' + formData, function (data) {
                    const responseDoc = document.createElement('html');
                    responseDoc.innerHTML = data;

                    const $newContainer = $(responseDoc).find('#dashboardContainer');
                    if ($newContainer.length > 0) {
                        // Destruir instâncias ativas do Chart.js
                        if (window.chartFluxoCaixaInst) { window.chartFluxoCaixaInst.destroy(); window.chartFluxoCaixaInst = null; }
                        if (window.chartDespesasInst) { window.chartDespesasInst.destroy(); window.chartDespesasInst = null; }
                        if (window.chartEvolucaoSaldoInst) { window.chartEvolucaoSaldoInst.destroy(); window.chartEvolucaoSaldoInst = null; }

                        $('#dashboardContainer').replaceWith($newContainer);

                        // Reexecutar os scripts inline que contêm os novos dados serializados dos gráficos
                        const scripts = responseDoc.querySelectorAll('script');
                        scripts.forEach(s => {
                            if (s.text && s.text.includes('chartFluxoCaixa')) {
                                try {
                                    // Isolamos a execução dos scripts de inicialização de gráfico
                                    const cleanScript = s.text
                                        .replace(/const ctxFluxo/g, 'var ctxFluxo')
                                        .replace(/const ctxDespesas/g, 'var ctxDespesas')
                                        .replace(/const ctxEvolucao/g, 'var ctxEvolucao')
                                        .replace(/const despesasLabels/g, 'var despesasLabels')
                                        .replace(/const despesasValores/g, 'var despesasValores')
                                        .replace(/const despesasCores/g, 'var despesasCores')
                                        .replace(/const brl/g, 'var brl')
                                        .replace(/const valueLabelPlugin/g, 'var valueLabelPlugin');
                                    eval(cleanScript);
                                } catch (e) {
                                    console.error('Erro ao recriar gráficos via AJAX:', e);
                                }
                            }
                        });
                    }
                }).fail(function () {
                    console.error('Erro ao filtrar dashboard via AJAX');
                }).always(function() {
                    requisicaoEmAndamento = false;
                });
            }

            $(document).off('click', '.btn-mes-filtro').on('click', '.btn-mes-filtro', function(e) {
                e.preventDefault();
                const mes = $(this).data('mes');
                $('#filtroMesDashboard').val(mes);
                carregarDashboard($('#formFiltroDashboard').serialize());
            });

            $(document).off('change', '#filtroAnoDashboard').on('change', '#filtroAnoDashboard', function(e) {
                e.preventDefault();
                carregarDashboard($('#formFiltroDashboard').serialize());
            });
        });
    </script>
}