@model GestorContas.Web.Models.Categoria

@{
    ViewData["Title"] = "Excluir Categoria";
}

@if (Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
{
    <div>
        <div class="alert alert-warning" role="alert">
            <i class="bi bi-info-circle-fill"></i>
            Deseja realmente excluir a categoria: <strong>@Model.Nome</strong>?
        </div>

        @if (Model.Lancamentos != null && Model.Lancamentos.Any())
        {
            <div class="alert alert-danger" role="alert">
                <i class="bi bi-exclamation-octagon-fill"></i>
                Esta categoria possui <strong>@Model.Lancamentos.Count lançamento(s)</strong> associado(s) e não pode ser excluída.
            </div>
        }

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="d-flex justify-content-end">
                @if (Model.Lancamentos == null || !Model.Lancamentos.Any())
                {
                    <button type="submit" class="btn btn-danger me-2">Confirmar Exclusão</button>
                }
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </form>
    </div>
}
else
{
    <div class="container">
        <!-- Full view content... same as original -->
        <div class="row justify-content-center">
            <div class="col-lg-6">
                <div class="card shadow-lg border-danger">
                    <div class="card-header bg-danger text-white">
                        <h3 class="mb-0"><i class="bi bi-exclamation-triangle-fill"></i> Confirmar Exclusão</h3>
                    </div>
                    <div class="card-body p-4">
                        <div class="alert alert-warning" role="alert">
                            <strong>Atenção!</strong> Você está prestes a excluir esta categoria.
                        </div>
                        <div class="card bg-light mb-4">
                            <div class="card-body">
                                <p><strong>Nome:</strong> @Model.Nome</p>
                            </div>
                        </div>
                        <form asp-action="Delete" method="post">
                            <input type="hidden" asp-for="Id" />
                            <div class="d-flex justify-content-between">
                                <a asp-action="Index" class="btn btn-outline-secondary btn-lg">Cancelar</a>
                                @if (Model.Lancamentos == null || !Model.Lancamentos.Any())
                                {
                                    <button type="submit" class="btn btn-danger btn-lg">Confirmar Exclusão</button>
                                }
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <style>
        .detail-item {
            padding: 0.75rem;
            border-left: 3px solid #0d6efd;
            background-color: white;
            border-radius: 0.25rem;
        }
    </style>
}
