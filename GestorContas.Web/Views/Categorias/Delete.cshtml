@model GestorContas.Web.Models.Categoria

@{
    ViewData["Title"] = "Excluir Categoria";
}

<div class="container">
    <div class="row justify-content-center">
        <div class="col-lg-6">
            <div class="card shadow-lg border-danger">
                <div class="card-header bg-danger text-white">
                    <h3 class="mb-0">
                        <i class="bi bi-exclamation-triangle-fill"></i> Confirmar Exclusão
                    </h3>
                </div>
                <div class="card-body p-4">
                    <div class="alert alert-warning" role="alert">
                        <i class="bi bi-info-circle-fill"></i>
                        <strong>Atenção!</strong> Você está prestes a excluir esta categoria. Esta ação não pode ser desfeita.
                    </div>

                    @if (Model.Lancamentos != null && Model.Lancamentos.Any())
                    {
                        <div class="alert alert-danger" role="alert">
                            <i class="bi bi-exclamation-octagon-fill"></i>
                            <strong>Aviso Importante!</strong> Esta categoria possui <strong>@Model.Lancamentos.Count lançamento(s)</strong> associado(s). 
                            Não é possível excluí-la enquanto houver lançamentos vinculados.
                        </div>
                    }

                    <div class="card bg-light mb-4">
                        <div class="card-body">
                            <h5 class="card-title text-primary mb-3">Detalhes da Categoria</h5>
                            
                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="detail-item">
                                        <label class="text-muted small fw-bold">
                                            <i class="bi bi-tag-fill"></i> Nome
                                        </label>
                                        <p class="mb-0 fw-semibold fs-5">@Model.Nome</p>
                                    </div>
                                </div>

                                @if (Model.Lancamentos != null)
                                {
                                    <div class="col-12">
                                        <div class="detail-item">
                                            <label class="text-muted small fw-bold">
                                                <i class="bi bi-cash-stack"></i> Lançamentos Associados
                                            </label>
                                            <p class="mb-0">
                                                <span class="badge @(Model.Lancamentos.Any() ? "bg-warning" : "bg-success")">
                                                    @Model.Lancamentos.Count lançamento(s)
                                                </span>
                                            </p>
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>

                    <form asp-action="Delete" method="post">
                        <input type="hidden" asp-for="Id" />
                        
                        <hr class="my-4">

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-outline-secondary btn-lg">
                                <i class="bi bi-arrow-left"></i> Cancelar
                            </a>
                            @if (Model.Lancamentos == null || !Model.Lancamentos.Any())
                            {
                                <button type="submit" class="btn btn-danger btn-lg">
                                    <i class="bi bi-trash"></i> Confirmar Exclusão
                                </button>
                            }
                            else
                            {
                                <button type="button" class="btn btn-danger btn-lg disabled" disabled>
                                    <i class="bi bi-trash"></i> Não é Possível Excluir
                                </button>
                            }
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    
    <style>
        .detail-item {
            padding: 0.75rem;
            border-left: 3px solid #0d6efd;
            background-color: white;
            border-radius: 0.25rem;
        }
    </style>
}
