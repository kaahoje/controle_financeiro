@model IEnumerable<GestorContas.Web.Models.Categoria>

@{
    ViewData["Title"] = "Categorias";
}

<div class="container-fluid">
    <div class="page-header d-flex flex-column mb-4 pb-3 border-bottom">
        <div class="header-title-container mb-3">
            <h2 class="h3 fw-bold text-dark mb-0 d-flex align-items-center">
                <div class="icon-box bg-primary-subtle text-primary rounded-3 me-3 d-flex align-items-center justify-content-center" style="width: 48px; height: 48px;">
                    <i class="bi bi-tags-fill fs-4"></i>
                </div>
                <span>Categorias</span>
            </h2>
        </div>
        <div class="header-actions-container">
            <div class="d-flex flex-wrap gap-2">
                <a asp-action="Create" class="btn btn-primary shadow-sm px-3 btn-modal" title="Nova Categoria">
                    <i class="bi bi-plus-lg me-1"></i> Nova Categoria
                </a>
            </div>
        </div>
    </div>

    @if (TempData["MensagemSucesso"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-check-circle-fill"></i> @TempData["MensagemSucesso"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    @if (TempData["MensagemErro"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
            <i class="bi bi-exclamation-triangle-fill"></i> @TempData["MensagemErro"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
    }

    <!-- Tabela de Categorias -->
    <div id="gridContainer">
        <div class="card shadow-sm">
            <div class="card-header bg-light">
                <h5 class="mb-0"><i class="bi bi-list-ul"></i> Lista de Categorias</h5>
            </div>
            <div class="card-body p-0">
                @if (Model.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-hover table-striped mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>Nome</th>
                                    <th class="text-center">Ações</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var item in Model)
                                {
                                    <tr>
                                        <td class="fw-semibold">
                                            <i class="bi bi-tag-fill text-primary"></i> @item.Nome
                                            @if (item.ParaTransferencia)
                                            {
                                                <span class="badge bg-info text-dark ms-2" title="Categoria de Transferência Interna">
                                                    <i class="bi bi-arrow-left-right"></i> Transferência
                                                </span>
                                            }
                                        </td>
                                        <td class="text-center">
                                            <div class="btn-group" role="group">
                                                <a asp-action="Edit" asp-route-id="@item.Id" 
                                                   class="btn btn-sm btn-outline-primary btn-modal" 
                                                   title="Editar Categoria">
                                                    <i class="bi bi-pencil-square"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@item.Id" 
                                                   class="btn btn-sm btn-outline-danger btn-modal" 
                                                   title="Excluir Categoria">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5">
                        <i class="bi bi-inbox display-1 text-muted"></i>
                        <p class="lead text-muted mt-3">Nenhuma categoria cadastrada.</p>
                        <a asp-action="Create" class="btn btn-primary btn-modal" title="Criar Primeira Categoria">
                            <i class="bi bi-plus-circle"></i> Criar Primeira Categoria
                        </a>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <script>
        function Filtrar() {
            $.get(window.location.href, function (data) {
                $('#gridContainer').html($(data).find('#gridContainer').html());
            });
        }
    </script>
}
