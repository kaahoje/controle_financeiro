@model IEnumerable<GestorContas.Web.Models.Prefeitura>

@{
    ViewData["Title"] = "Prefeituras";
}

<div class="container-fluid">
    <div class="row mb-4">
        <div class="col-12">
            <div class="d-flex justify-content-between align-items-center">
                <h1 class="display-5 fw-bold text-primary">
                    <i class="bi bi-building-fill"></i> Prefeituras
                </h1>
                <a asp-action="Create" class="btn btn-success btn-lg shadow-sm btn-modal" title="Novo Registro">
                    <i class="bi bi-plus-circle"></i> Novo Registro
                </a>
            </div>
        </div>
    </div>


    <!-- Filtros -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0"><i class="bi bi-funnel"></i> Filtros (Vencimento)</h5>
        </div>
        <div class="card-body">
            <form id="formFiltro" method="get">
                <div class="row g-3">
                    <div class="col-md-3">
                        <label class="form-label fw-bold">Descrição</label>
                        <input type="text" name="busca" class="form-control" placeholder="Buscar por descrição..." value="@ViewBag.Busca" />
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Mês</label>
                        <select name="mes" class="form-select">
                            @foreach (var mes in ViewBag.Meses)
                            {
                                <option value="@mes.Id" selected="@(mes.Id == ViewBag.MesSelecionado)">@mes.Nome</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Ano</label>
                        <select name="ano" class="form-select">
                            @foreach (var ano in ViewBag.Anos)
                            {
                                <option value="@ano" selected="@(ano == ViewBag.AnoSelecionado)">@ano</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label fw-bold">Tipo</label>
                        <select name="tipo" class="form-select">
                            <option value="">Todos</option>
                            <option value="true" selected="@(ViewBag.Tipo == true)">Recebimento</option>
                            <option value="false" selected="@(ViewBag.Tipo == false)">Pagamento</option>
                        </select>
                    </div>
                    <div class="col-md-3 d-flex align-items-end">
                        <button type="button" class="btn btn-primary me-2" onclick="Filtrar()">
                            <i class="bi bi-search"></i> Filtrar
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">
                            <i class="bi bi-x-circle"></i> Limpar
                        </a>
                    </div>
                </div>
            </form>
        </div>
    </div>

    <!-- Grid de Dados (Inclui os totalizadores via AJAX) -->
    <div id="gridContainer">
        @await Html.PartialAsync("_GridPrefeituras", Model)
    </div>
</div>

@section Scripts {
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.0/font/bootstrap-icons.css">
    <script>
        let timeout = null;
        function Filtrar() {
            const form = $('#formFiltro');
            const url = window.location.pathname;
            const formData = form.serialize();

            $.get(url + '?' + formData, function (data) {
                $('#gridContainer').html(data);
            }).fail(function () {
                console.error('Erro ao filtrar prefeituras');
            });
        }

        $(function() {
            // Filtro automático para selects
            $('#formFiltro select').on('change', function() {
                Filtrar();
            });

            // Filtro automático para o campo de busca (com delay para não sobrecarregar)
            $('#formFiltro input[name="busca"]').on('keyup', function() {
                clearTimeout(timeout);
                timeout = setTimeout(function() {
                    Filtrar();
                }, 500);
            });
        });
    </script>
    <script>
        $(function () {
            // Mensagens do servidor via TempData
            @if (TempData["MensagemSucesso"] != null)
            {
                <text>showToast('@TempData["MensagemSucesso"]', 'Sucesso', 'success');</text>
            }
            @if (TempData["MensagemErro"] != null)
            {
                <text>showToast('@TempData["MensagemErro"]', 'Erro', 'danger');</text>
            }
        });
    </script>
}
