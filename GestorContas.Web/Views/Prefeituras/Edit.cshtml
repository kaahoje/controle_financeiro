@model GestorContas.Web.Models.Prefeitura

@{
    ViewData["Title"] = "Editar Registro de Prefeitura";
}

@if (Context.Request.Headers["X-Requested-With"] == "XMLHttpRequest")
{
    <div>
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
            <input type="hidden" asp-for="Id" />
            <div class="row g-3">
                <div class="col-12">
                    <div class="form-floating">
                        <input asp-for="Descricao" class="form-control" id="modal_pref_descricao" placeholder="Descrição" autofocus />
                        <label asp-for="Descricao">Descrição</label>
                        <span asp-validation-for="Descricao" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="Valor" class="form-control" id="modal_pref_valor" type="number" step="0.01" placeholder="0,00" />
                        <label asp-for="Valor">Valor</label>
                        <span asp-validation-for="Valor" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="form-floating">
                        <input asp-for="VencimentoDaParcela" asp-format="{0:yyyy-MM-dd}" class="form-control" id="modal_pref_venc" type="date" />
                        <label asp-for="VencimentoDaParcela">Vencimento da Parcela</label>
                        <span asp-validation-for="VencimentoDaParcela" class="text-danger small"></span>
                    </div>
                </div>
                <div class="col-12">
                    <div class="form-check form-switch mt-2">
                        <input class="form-check-input" type="checkbox" asp-for="Entrada" id="modal_pref_tipo">
                        <label class="form-check-label fw-bold" for="modal_pref_tipo">
                            É Recebimento? <small class="text-muted fw-normal">(Ativado = Recebimento | Desativado = Pagamento)</small>
                        </label>
                        <span asp-validation-for="Entrada" class="text-danger small d-block"></span>
                    </div>
                </div>
            </div>
            <hr class="my-4">
            <div class="d-flex justify-content-end">
                <button type="submit" class="btn btn-primary me-2">Salvar Alterações</button>
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </form>
    </div>
}
else
{
    <div class="container py-4">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <div class="card shadow">
                    <div class="card-header bg-primary text-white">
                        <h4 class="mb-0">Editar Registro de Prefeitura</h4>
                    </div>
                    <div class="card-body p-4">
                        <form asp-action="Edit" method="post">
                            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
                            <input type="hidden" asp-for="Id" />
                            <div class="row g-3">
                                <div class="col-12">
                                    <div class="form-floating">
                                        <input asp-for="Descricao" class="form-control" placeholder="Descrição" autofocus />
                                        <label asp-for="Descricao">Descrição</label>
                                        <span asp-validation-for="Descricao" class="text-danger small"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="Valor" class="form-control" type="number" step="0.01" />
                                        <label asp-for="Valor">Valor</label>
                                        <span asp-validation-for="Valor" class="text-danger small"></span>
                                    </div>
                                </div>
                                <div class="col-md-6">
                                    <div class="form-floating">
                                        <input asp-for="VencimentoDaParcela" asp-format="{0:yyyy-MM-dd}" class="form-control" type="date" />
                                        <label asp-for="VencimentoDaParcela">Vencimento da Parcela</label>
                                        <span asp-validation-for="VencimentoDaParcela" class="text-danger small"></span>
                                    </div>
                                </div>
                                <div class="col-12">
                                    <div class="form-check form-switch mt-2">
                                        <input class="form-check-input" type="checkbox" asp-for="Entrada">
                                        <label class="form-check-label fw-bold">
                                            É Recebimento? <small class="text-muted fw-normal">(Ativado = Recebimento | Desativado = Pagamento)</small>
                                        </label>
                                        <span asp-validation-for="Entrada" class="text-danger small d-block"></span>
                                    </div>
                                </div>
                            </div>
                            <hr class="my-4">
                            <div class="d-flex justify-content-between">
                                <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                                <button type="submit" class="btn btn-primary">Salvar Alterações</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
}
