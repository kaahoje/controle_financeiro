@model IEnumerable<GestorContas.Web.Models.Prefeitura>

<!-- Totalizadores -->
<div class="row mb-4">
    <div class="col-md-4">
        <div class="card shadow-sm border-success bg-light">
            <div class="card-body text-center">
                <h6 class="text-muted mb-2">Recebimentos (Acumulado)</h6>
                <h3 class="text-success fw-bold mb-0">
                    <i class="bi bi-plus-circle-fill"></i> @(((decimal)ViewBag.TotalRecebimentos).ToString("C"))
                </h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-danger bg-light">
            <div class="card-body text-center">
                <h6 class="text-muted mb-2">Pagamentos (Acumulado)</h6>
                <h3 class="text-danger fw-bold mb-0">
                    <i class="bi bi-dash-circle-fill"></i> @(((decimal)ViewBag.TotalPagamentos).ToString("C"))
                </h3>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card shadow-sm border-primary bg-light">
            <div class="card-body text-center">
                <h6 class="text-muted mb-2">Saldo Geral (Acumulado)</h6>
                <h3 class="@((decimal)ViewBag.SaldoMes >= 0 ? "text-primary" : "text-danger") fw-bold mb-0">
                    <i class="bi bi-wallet2"></i> @(((decimal)ViewBag.SaldoMes).ToString("C"))
                </h3>
            </div>
        </div>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-light d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-list-ul"></i> Detalhamento das Prefeituras</h5>
        <span class="badge bg-primary">@Model.Count() registros no mês</span>
    </div>
    <div class="card-body p-0">
        @if (Model.Any())
        {
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Data Vencimento</th>
                            <th>Descrição</th>
                            <th class="text-end">Valor</th>
                            <th class="text-center">Tipo</th>
                            <th class="text-center">Ações</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{
                            var grupos = Model.GroupBy(p => p.Entrada).OrderByDescending(g => g.Key);
                        }

                        @foreach (var grupo in grupos)
                        {
                            <tr class="@(grupo.Key == true ? "table-success text-success" : "table-danger text-danger") fw-bold">
                                <td colspan="5">
                                    <i class="bi @(grupo.Key == true ? "bi-arrow-up-circle-fill" : "bi-arrow-down-circle-fill")"></i>
                                    @(grupo.Key == true ? "RECEBIMENTOS" : "PAGAMENTOS")
                                </td>
                            </tr>

                            @foreach (var item in grupo)
                            {
                                <tr>
                                    <td>
                                        <span class="badge bg-secondary">
                                            @(item.VencimentoDaParcela?.ToString("dd/MM/yyyy") ?? "-")
                                        </span>
                                    </td>
                                    <td class="fw-semibold">@item.Descricao</td>
                                    <td class="text-end fw-bold @(item.Entrada == true ? "text-success" : "text-danger")">
                                        @(item.Valor?.ToString("C") ?? "-")
                                    </td>
                                    <td class="text-center">
                                        @if (item.Entrada == true)
                                        {
                                            <span class="badge bg-success">Recebimento</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">Pagamento</span>
                                        }
                                    </td>
                                    <td class="text-center">
                                        <div class="btn-group" role="group">
                                            
                                            <a asp-action="Edit" asp-route-id="@item.Id" 
                                               class="btn btn-sm btn-outline-primary btn-modal" 
                                               title="Editar">
                                                <i class="bi bi-pencil-square"></i>
                                            </a>
                                            <a asp-action="Delete" asp-route-id="@item.Id" 
                                               class="btn btn-sm btn-outline-danger btn-modal rounded-0" 
                                               title="Excluir">
                                                <i class="bi bi-trash"></i>
                                            </a>
                                            <form asp-action="Replicate" asp-route-id="@item.Id" method="post" 
                                                  class="d-inline form-ajax-replicate" data-confirm="Deseja replicar este registro para o mês seguinte?">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-sm btn-outline-success rounded-start-0" title="Replicar para próximo mês">
                                                    <i class="bi bi-arrow-right-circle"></i>
                                                </button>
                                            </form>
                                        </div>
                                    </td>
                                </tr>
                            }

                            <tr class="bg-light fw-bold text-end">
                                <td colspan="2" class="text-end text-muted">Subtotal @(grupo.Key == true ? "Recebimentos" : "Pagamentos"):</td>
                                <td class="text-end @(grupo.Key == true ? "text-success" : "text-danger")" style="font-size: 1.1rem;">
                                    @grupo.Sum(p => p.Valor ?? 0).ToString("C")
                                </td>
                                <td colspan="2"></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="bi bi-inbox display-1 text-muted"></i>
                <p class="lead text-muted mt-3">Nenhum registro para este período.</p>
            </div>
        }
    </div>
</div>
